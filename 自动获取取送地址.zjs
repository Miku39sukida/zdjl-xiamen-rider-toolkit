{"repeatCount":-1,"pauseOnFail":true,"count":2,"minVerCode":2015000,"minVerName":"2.15.0","screenWidth":1080,"screenHeight":2400,"screenDpi":3,"lastSaveScreenWidth":1080,"lastSaveScreenHeight":2400,"lastSaveScreenDpi":3,"savedVerCode":2028030,"savedVerName":"2.28.3","description":"【专为自动导航脚本适配｜取送地址提取工具】\r\n\r\n使用前提\r\n\r\n1. 需在饿了么\/美团众包「抢单\/订单列表」页面运行\r\n2. 建议配合自动导航脚本使用，实现地址提取→导航的完整自动化流程\r\n\r\n核心功能\r\n\r\n- 智能地址提取：自动识别订单卡片中的商家名称、取货地址、顾客地址，支持多套UI布局兜底，适配不同版本\r\n- 多单智能选择：支持多订单场景，自动弹出选择弹窗，可选择提取第几单的地址信息\r\n- 地址智能处理：自动清洗地址文本，去除冗余信息，提取核心地址用于导航匹配\r\n- 一键复制功能：提供弹窗选择复制商家名称、取货地址或顾客地址，支持快速粘贴到导航输入框\r\n- UNMATCH前缀支持：检测到[UNMATCH]前缀时自动过滤，并弹出二级弹窗，所有复制内容自动添加前缀标识，便于后续脚本识别处理\r\n- 商家别名配置：支持自定义商家别名配置文件，自动替换常用商家名称，提升地址识别准确度\r\n\r\n技术特点\r\n\r\n- 多维度地址识别：结合文本特征、UI布局、节点位置等多重判断，确保提取准确率\r\n- 地址智能清洗：自动处理门牌号、楼栋号、楼层信息，去除重复地址片段，提取最精简的导航地址\r\n- 兼容性强：适配不同UI版本，通过多套兜底方案确保在各种界面布局下都能正常工作\r\n- 性能优化：使用本地OCR识别，响应速度快，不影响操作流畅度\r\n\r\n使用场景\r\n\r\n- 配合自动导航脚本：提取地址后自动传递给导航脚本，实现从订单列表到导航启动的全流程自动化\r\n- 快速地址复制：在订单列表页面一键提取并复制地址，手动粘贴到其他导航应用\r\n- 地址信息整理：批量提取多个订单地址，便于路线规划和配送安排\r\n\r\n专为骑手跑单场景设计，与自动导航脚本完美配合，实现订单地址提取到导航启动的无缝衔接，大幅提升配送效率。\r\n\r\n","delay":"","fromShare":{"id":"6969297ce4b0f71ed330f331","userId":"sub_379134_1jf1cd1t9","md5":"5fb92aa1f29000a03d498f394633d06e","downloadTime":1768499601301},"fromStore":{"id":"696929c3e4b0f71ed330f3a7","userId":"weixin_o00rys3Kd8HULo8sa3nc5OEpjcVw","md5":"cfbb53b643564990b2ac510d55de7fc3","downloadTime":1768500070286,"videoUrl":""}}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"提取商家名称，包括详细地址和顾客地址。","jsCode":"\/**\r\n * 自动精灵\/饿了么众包：从“抢单\/订单列表”页提取\r\n * - 商家名称\r\n * - 商家详细地址（取货地址）\r\n * - 顾客地址（送达地址）\r\n *\r\n * 说明：\r\n * - 该页面通常每个订单卡片会出现：商家名(TextView) -> 地址(TextView) -> 下一个地址(TextView)\r\n * - UI 可能调整，所以脚本做了多套兜底（按文本特征 + bounds 相对位置）\r\n *\r\n * 输出：\r\n * - console.log 打印结果\r\n * - 可选：写入剪贴板（默认开启）\r\n *\/\r\n\r\n\/\/ 是否自动复制（如果你希望“只点按钮才复制”，把它设为 false）\r\nconst COPY_TO_CLIPBOARD = false;\r\n\/\/ 是否弹出“点击复制”按钮（推荐开启）\r\nconst SHOW_COPY_BUTTON = true;\r\n\/\/ 是否用弹窗显示提取结果（包含顾客地址）\r\nconst SHOW_RESULT_ALERT = false;\r\n\/\/ 多单情况下是否弹出“选择第几单”\r\nconst SHOW_ORDER_PICKER = true;\r\n\/\/ 是否自动打开控制台（一般不需要，调试时再打开）\r\nconst AUTO_SHOW_CONSOLE = false;\r\n\/\/ 提取第几单（从 0 开始：0=最上面那单，1=第二单...）\r\nconst ORDER_INDEX = 0;\r\nconst DEBUG_DUMP_CANDIDATES = false;\r\n\r\n\/\/ 商家别名配置文件路径（优先手机内部存储，其次脚本同目录）\r\n\/\/ - 内部存储常见路径：\/sdcard == \/storage\/emulated\/0\r\n\/\/ - 结构示例见仓库的 merchant_alias.json\r\nconst MERCHANT_ALIAS_CONFIG_PATHS = [\r\n  '\/sdcard\/merchant_alias.json',\r\n  '\/sdcard\/zdjl\/merchant_alias.json',\r\n  '\/storage\/emulated\/0\/merchant_alias.json',\r\n  'merchant_alias.json' \/\/ 脚本同目录兜底\r\n];\r\n\r\n\/\/ 通用常量（集中管理，减少重复）\r\nconst ORG_SUFFIX_RE =\r\n  \/(有限公司|有限责任公司|公司|集团|研究院|事务所|工作室|学校|幼儿园|服务中心|营业厅|驿站|快递驿站)\/;\r\nconst VILLAGE_SUFFIX_RE = \/(社|村|里|社区|社區|居委会|居委會|小区|小區)$\/;\r\nconst VILLAGE_NAME_PREFIX_RE = \/^([\\u4e00-\\u9fa5A-Za-z0-9·]{2,20}(?:社|村|里|社区|社區|居委会|居委會|小区|小區))\/;\r\nconst KEY_DELIVERY_POI_RE =\r\n  \/(酒店|宾馆|网吧|网咖|电竞馆|电竞|棋牌室|棋牌|桌游|台球|会所|酒吧|KTV|ktv|健身|运动|体育场|体育館|体育馆|球场|球場|宿舍|宿舍楼|宿舍樓|宿舍区|宿舍區|便利店|超市|药房|药店|医院|住院部|门诊|急诊|体检中心|服务中心|营业厅|驿站|快递驿站|充电站)\/;\r\n\r\nfunction normalizeText(t) {\r\n  if (!t) return '';\r\n  \/\/ 去掉一些常见不可见字符（如控件里尾号后的“￼” U+FFFC）\r\n  return String(t)\r\n    .replace(\/[\\u200B-\\u200F\\uFEFF\\u2060\\uFFFC]\/g, '')\r\n    .replace(\/\\u00a0\/g, ' ')\r\n    .replace(\/\\s+\\n\/g, '\\n')\r\n    .trim();\r\n}\r\n\r\nfunction normalizeHaoZhi(text) {\r\n  \/\/ 形如：5号之一 \/ 5號之九 \/ 12号之3 => 5-1 \/ 5-9 \/ 12-3\r\n  \/\/ 仅处理“号之”这一类常见门牌表达，不影响其它文本\r\n  const s = normalizeText(text);\r\n  if (!s) return '';\r\n\r\n  const cnDigitMap = {\r\n    零: '0',\r\n    〇: '0',\r\n    一: '1',\r\n    二: '2',\r\n    三: '3',\r\n    四: '4',\r\n    五: '5',\r\n    六: '6',\r\n    七: '7',\r\n    八: '8',\r\n    九: '9',\r\n    十: '10'\r\n  };\r\n\r\n  return s.replace(\/(\\d+)\\s*[号號]\\s*之\\s*([零〇一二三四五六七八九十]|\\d+)\/g, (_, n, tail) => {\r\n    const t = String(tail);\r\n    const digit = cnDigitMap[t] ?? t;\r\n    return `${n}-${digit}`;\r\n  });\r\n}\r\n\r\nfunction cnNumeralToInt(cn) {\r\n  \/\/ 简单中文数字转整数（支持 0-99 常见写法）\r\n  \/\/ 例：一=1，十=10，十一=11，二十=20，二十三=23，两=2\r\n  const s = String(cn || '').trim();\r\n  if (!s) return null;\r\n  if (\/^\\d+$\/.test(s)) return parseInt(s, 10);\r\n\r\n  const map = { 零: 0, 〇: 0, 一: 1, 二: 2, 两: 2, 三: 3, 四: 4, 五: 5, 六: 6, 七: 7, 八: 8, 九: 9 };\r\n\r\n  \/\/ 十 \/ 十一 \/ 二十 \/ 二十三\r\n  if (s === '十') return 10;\r\n  if (s.length === 2 && s[0] === '十' && map[s[1]] != null) return 10 + map[s[1]];\r\n  if (s.length === 2 && map[s[0]] != null && s[1] === '十') return map[s[0]] * 10;\r\n  if (s.length === 3 && map[s[0]] != null && s[1] === '十' && map[s[2]] != null)\r\n    return map[s[0]] * 10 + map[s[2]];\r\n\r\n  \/\/ 单个数字\r\n  if (s.length === 1 && map[s] != null) return map[s];\r\n  return null;\r\n}\r\n\r\nfunction normalizeCnBuildingNumbers(text) {\r\n  \/\/ 将“一号楼\/一號樓\/一栋\/一棟\/一单元\/一梯\/一座”等转换为阿拉伯数字，便于导航匹配\r\n  const s = normalizeText(text);\r\n  if (!s) return '';\r\n\r\n  const cnRe = '[零〇一二三四五六七八九十两\\\\d]{1,4}';\r\n  const hao = '[号號]';\r\n  const lou = '[楼樓]';\r\n  const dong = '[栋棟]';\r\n  const danYuan = '(?:单元|單元)';\r\n  const other = '(?:座|梯)';\r\n\r\n  return s.replace(\r\n    new RegExp(`(${cnRe})\\\\s*(?:${hao}\\\\s*${lou}|${hao}|${dong}|${danYuan}|${other})`, 'g'),\r\n    (m0, nRaw) => {\r\n      const n = cnNumeralToInt(nRaw);\r\n      if (!Number.isFinite(n)) return m0;\r\n      \/\/ 还原后缀（保持原文本后缀形态）\r\n      return m0.replace(String(nRaw), String(n));\r\n    }\r\n  );\r\n}\r\n\r\nfunction dedupeRepeatedDoorplate(text) {\r\n  \/\/ 去掉重复门牌号：例如“139号139号” -> “139号”\r\n  \/\/ 兼容繁体“號”，以及中间可能存在空格\r\n  const s = normalizeText(text);\r\n  if (!s) return '';\r\n\r\n  \/\/ 针对“数字重复 + 简繁混用”的最小归一：\r\n  \/\/ - 把全角数字 ０-９ 归一成 0-9（就地处理，避免全局改动）\r\n  \/\/ - 把常见楼栋相关繁体归一为简体（只影响门牌去重链路）\r\n  const x = s\r\n    .replace(\/\\u3000\/g, ' ') \/\/ 全角空格\r\n    .replace(\/[０-９]\/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xff10 + 0x30))\r\n    .replace(\/號\/g, '号')\r\n    .replace(\/樓\/g, '楼')\r\n    .replace(\/棟\/g, '栋')\r\n    .replace(\/層\/g, '层')\r\n    .replace(\/單元\/g, '单元')\r\n    \/\/ 先处理“同号 + 楼”类重复（必须同一数字重复出现）：\r\n    \/\/ - 2号2號樓 \/ 2号2楼 \/ 2號2號樓 -> 2号楼\r\n    \/\/ - 2号楼2號樓 \/ 2號樓2号楼 -> 2号楼\r\n    \/\/ 放在门牌去重前，避免先被门牌去重截断成“2号樓”。\r\n    .replace(\/(\\d+)\\s*号\\s*\\1\\s*(?:号)?\\s*楼\/g, '$1号楼')\r\n    .replace(\/(\\d+)\\s*号\\s*楼\\s*\\1\\s*号\\s*楼\/g, '$1号楼');\r\n  \/\/ 捕获第一个“号\/號”，并将后续重复的同号段合并\r\n  return x.replace(\/(\\d+)\\s*号\\s*\\1\\s*号\/g, '$1号');\r\n}\r\n\r\nfunction dedupeRepeatedVillageName(text) {\r\n  \/\/ 城中村\/社区名重复：常见形式 “小东山社（...小东山社22号...）”\r\n  \/\/ 目标：去掉中间重复的行政区\/街道描述，直接保留到带门牌的那一段\r\n  \/\/ 例：小东山社（厦门市湖里区殿前街道小东山社22号4层***） -> 小东山社22号4层***\r\n  const s = normalizeText(text);\r\n  if (!s) return '';\r\n\r\n  \/\/ 常见村社\/社区后缀（可按需继续扩展）\r\n  const m = s.match(VILLAGE_NAME_PREFIX_RE);\r\n  if (!m || !m[1]) return s;\r\n  const name = String(m[1]).trim();\r\n  if (!name) return s;\r\n\r\n  \/\/ 找第二次出现（通常在括号里），并且后面应当跟门牌\/楼栋信息才认为是“有效重复”\r\n  const secondIdx = s.indexOf(name, name.length);\r\n  if (secondIdx < 0) return s;\r\n  const tail = s.slice(secondIdx + name.length);\r\n  if (!\/[\\d一二三四五六七八九十两兩]\/.test(tail) && !\/[号號楼樓栋棟幢座单元單元梯]\/.test(tail)) return s;\r\n\r\n  const merged = `${name}${tail}`.replace(\/[（）()]\/g, '').trim();\r\n  return merged || s;\r\n}\r\n\r\nfunction dedupeVillageCoreRepeat(text) {\r\n  \/\/ 社区\/城中村名“核心重复”：\r\n  \/\/ 例：后埔社后埔240号楼（6层***） -> 后埔社240号楼（6层***）\r\n  \/\/ 例：县后社县后社421号 -> 县后社421号\r\n  const s = normalizeText(text);\r\n  if (!s) return '';\r\n\r\n  const m = s.match(VILLAGE_NAME_PREFIX_RE);\r\n  if (!m || !m[1]) return s;\r\n  const name = String(m[1]).trim();\r\n  if (!name) return s;\r\n\r\n  \/\/ 去掉后缀得到核心（如“后埔社” -> “后埔”）\r\n  const core = name.replace(VILLAGE_SUFFIX_RE, '').trim();\r\n  if (!core || core.length < 2) return s;\r\n\r\n  const rest = s.slice(name.length);\r\n  \/\/ 仅当紧跟着就是 core（可带空格\/括号）时才去重，避免误删正常文本\r\n  const re = new RegExp(`^\\\\s*[（(]?\\\\s*${core}`);\r\n  if (!re.test(rest)) return s;\r\n\r\n  \/\/ 把紧跟的 core 删除一次\r\n  const newRest = rest.replace(re, '').trimStart();\r\n  return `${name}${newRest}`.trim();\r\n}\r\n\r\nfunction stripJdPipeDelimitedPrefix(text) {\r\n  \/\/ 京东\/蜂鸟等渠道偶发把“行政区”与“完整地址”用特殊分隔拼接：\r\n  \/\/ 例：厦门市思明区|,|福建厦门市思明区筼筜街道源盛花园393号楼7层*** -> 福建厦门市思明区筼筜街道源盛花园393号楼7层***\r\n  const s = normalizeText(text);\r\n  if (!s) return '';\r\n\r\n  \/\/ 兼容多种写法：|,| 或 |，| 或 | , |\r\n  const delimRe = \/\\|\\s*[,，]\\s*\\|\/g;\r\n  if (delimRe.test(s)) {\r\n    \/\/ 取最后一段（通常是最完整的地址）\r\n    const parts = s.split(delimRe).map(x => String(x).trim()).filter(Boolean);\r\n    const last = parts[parts.length - 1] || '';\r\n    return last || s;\r\n  }\r\n\r\n  \/\/ 兜底：去掉开头残留的管道\/逗号\r\n  return s.replace(\/^[|｜\\s,，]+\/, '').trim();\r\n}\r\n\r\nfunction trimCompanyFloorParen(text) {\r\n  \/\/ 更直接的“组织\/机构\/场所名截断”：\r\n  \/\/ 只要出现这些后缀，就保留到后缀为止（去掉后面的楼层\/前台\/密码等）\r\n  \/\/ 例：厦门美洋生活电子商务有限公司（29楼） -> 厦门美洋生活电子商务有限公司\r\n  const s = normalizeText(text);\r\n  if (!s) return '';\r\n\r\n  \/\/ 注意：这里刻意不包含“酒店\/宾馆\/网咖\/电竞馆”等，因为这些我们有更精细的 POI 逻辑（保留分店名）\r\n  const m = s.match(new RegExp(`^(.+?${ORG_SUFFIX_RE.source})(?:$|\\\\s|[，,;；：:（(【\\\\[]|\\\\d|\\\\*)`));\r\n  if (!m || !m[1]) return s;\r\n  return String(m[1]).trim();\r\n}\r\n\r\nfunction appendFollowingHaoLou(original, prefix) {\r\n  \/\/ 若 prefix 后面紧跟 “6号楼\/6號樓”，则追加（用于住院部\/服务中心等场所）\r\n  const s = normalizeText(original);\r\n  const p = normalizeText(prefix);\r\n  if (!s || !p) return p;\r\n  const idx = s.indexOf(p);\r\n  if (idx < 0) return p;\r\n  const rest = s.slice(idx + p.length);\r\n  const m = rest.match(\/^\\s*(\\d+)\\s*[号號]\\s*[楼樓]\/);\r\n  if (m && m[0]) return (p + m[0].replace(\/\\s+\/g, '')).trim();\r\n  return p;\r\n}\r\n\r\n\/\/ 顾客地址前缀清洗：去掉开头可选的“XX街道”\r\n\/\/ 例：`禾山街道枋湖工业小区...` -> `枋湖工业小区...`\r\nconst CUSTOMER_ADDRESS_PREFIX_RE = \/^[\\u4e00-\\u9fa5]{2,10}街道\\s*\/;\r\n\/\/ 顾客地址行政区划前缀清洗：只剥离“XX市XX区\/县\/旗”（可带省）\r\n\/\/ 目的：避免把“小区”当成“XX区”误删（如“樱花小区...”）\r\n\/\/ 兼容 OCR 把“市”识别成“是”（如“厦门是湖里区...”）\r\nconst CUSTOMER_ADDRESS_CITY_DISTRICT_PREFIX_RE =\r\n  \/^(?:[\\u4e00-\\u9fa5]{2,10}省\\s*)?(?:[\\u4e00-\\u9fa5]{2,10}[市是]\\s*)(?:[\\u4e00-\\u9fa5]{2,10}(?:区|县|旗)\\s*)\/;\r\nconst CUSTOMER_ADDRESS_CITY_ONLY_PREFIX_RE = \/^(?:[\\u4e00-\\u9fa5]{2,10}省\\s*)?[\\u4e00-\\u9fa5]{2,10}[市是]\\s*\/;\r\n\/\/ 同上，但用于“字符串中间出现省市区前缀”的拼接\/重复场景（不锚定开头）\r\nconst CUSTOMER_ADDRESS_CITY_DISTRICT_INNER_RE =\r\n  \/(?:[\\u4e00-\\u9fa5]{2,10}省\\s*)?(?:[\\u4e00-\\u9fa5]{2,10}[市是]\\s*)(?:[\\u4e00-\\u9fa5]{2,10}(?:区|县|旗)\\s*)\/g;\r\n\r\nfunction stripInnerCityDistrictDuplicate(text) {\r\n  \/\/ 京东\/蜂鸟等偶发把“街道地址 + 省市区地址”直接拼到一起：\r\n  \/\/ 例：筼筜街道屿后南里384-388号楼福建省厦门市思明区屿后南里384-388号楼388号202室\r\n  \/\/ 目标：优先保留最后一次出现的“省市区...”那段，再走原有前缀剥离与门牌裁剪\r\n  const s = normalizeText(text);\r\n  if (!s) return '';\r\n\r\n  let lastIdx = -1;\r\n  try {\r\n    for (const m of s.matchAll(CUSTOMER_ADDRESS_CITY_DISTRICT_INNER_RE)) {\r\n      if (!m) continue;\r\n      const idx = m.index ?? -1;\r\n      if (idx >= 0) lastIdx = idx;\r\n    }\r\n  } catch (_) {\r\n    \/\/ ignore\r\n  }\r\n  if (lastIdx > 0 && s.length - lastIdx >= 10) return s.slice(lastIdx).trim();\r\n  return s;\r\n}\r\n\r\nfunction cleanCustomerAddress(addr) {\r\n  let a = dedupeRepeatedDoorplate(normalizeCnBuildingNumbers(normalizeHaoZhi(addr)));\r\n  if (!a) return '';\r\n  a = stripJdPipeDelimitedPrefix(a);\r\n  a = stripInnerCityDistrictDuplicate(a);\r\n  a = dedupeRepeatedVillageName(a);\r\n  a = dedupeVillageCoreRepeat(a);\r\n  a = a.replace(CUSTOMER_ADDRESS_PREFIX_RE, '').trim();\r\n\r\n  \/\/ 先尝试去掉 “省\/市\/区”（但要求必须含“市”，避免误删“小区”）\r\n  \/\/ 可能出现重复（例如含省市区后又跟“xx市xx区”），循环剥离 2 次即可\r\n  for (let i = 0; i < 2; i++) {\r\n    const before = a;\r\n    a = a.replace(CUSTOMER_ADDRESS_CITY_DISTRICT_PREFIX_RE, '').trim();\r\n    if (a === before) break;\r\n  }\r\n\r\n  \/\/ 不再单独过滤\"XX市\"，保留完整的地址信息\r\n  return a;\r\n}\r\n\r\nfunction shortenForMenu(text, maxLen = 18) {\r\n  const t = normalizeText(text);\r\n  if (!t) return '';\r\n  if (t.length <= maxLen) return t;\r\n  return t.slice(0, maxLen - 1) + '…';\r\n}\r\n\r\nasync function pickOrderIndexInteractive(orders) {\r\n  if (!Array.isArray(orders) || orders.length === 0) return ORDER_INDEX;\r\n  if (orders.length === 1) return 0;\r\n\r\n  const items = orders.map((o, idx) => {\r\n    const m = shortenForMenu(o.merchantName, 10) || '(空商家)';\r\n    const p = shortenForMenu(o.merchantDetailAddress, 10) || '(空取货)';\r\n    const c = shortenForMenu(o.customerAddress, 10) || '(空顾客)';\r\n    return `${idx + 1}）${m}｜取:${p}｜顾:${c}`;\r\n  });\r\n\r\n  \/\/ 默认选中 ORDER_INDEX（如果越界就选第一单）\r\n  const defaultIdx = Math.max(0, Math.min(ORDER_INDEX, orders.length - 1));\r\n  const defaultItem = items[defaultIdx];\r\n\r\n  try {\r\n    const sel = await zdjl.selectAsync({\r\n      title: `识别到${orders.length}单，请选择要操作的订单`,\r\n      items,\r\n      selectItems: defaultItem ? [defaultItem] : undefined\r\n    });\r\n    const { index, text } = parseSelectReturn(sel);\r\n    if (Number.isFinite(index) && index >= 0) return Math.max(0, Math.min(index, orders.length - 1));\r\n    if (typeof text === 'string') {\r\n      const i = items.indexOf(text);\r\n      if (i >= 0) return i;\r\n    }\r\n  } catch (_) {\r\n    \/\/ ignore and fallback to ORDER_INDEX\r\n  }\r\n  return defaultIdx;\r\n}\r\n\r\nfunction isPendingDeliveryContext(allTextNodes) {\r\n  \/\/ 待送达\/配送中页面常见关键词：确认送达、剩xx分钟(…前送达)\r\n  const arr = Array.isArray(allTextNodes) ? allTextNodes : [];\r\n  return arr.some(n => {\r\n    const t = normalizeText(n?.text);\r\n    if (!t) return false;\r\n    if (\/确认送达\/.test(t)) return true;\r\n    if (\/剩\\d+分钟.*送达\/.test(t)) return true;\r\n    return false;\r\n  });\r\n}\r\n\r\nfunction isKeyDeliveryPoi(text) {\r\n  \/\/ 关键配送点：酒店\/宾馆\/网咖\/电竞等 POI 名称（常见不带路号楼栋）\r\n  \/\/ 目标：像 “XX酒店(XXX店)”“XX网咖”“XX棋牌室(园区)”“XX电竞(XX店)” 这种应当作为顾客地址保留\r\n  const t = normalizeText(text);\r\n  if (!t) return false;\r\n  if (isIgnorableTextForExtraction(t)) return false;\r\n\r\n  \/\/ 明显备注\/提示不要算 POI\r\n  if (isCustomerRemarkText(t)) return false;\r\n\r\n  const hasKeyword = KEY_DELIVERY_POI_RE.test(t);\r\n  if (!hasKeyword) return false;\r\n\r\n  \/\/ 宿舍场景：如果已经包含楼栋号信息（号楼\/B栋\/单元\/座\/梯等），应交给楼栋规则处理，\r\n  \/\/ 避免被 POI 裁剪成“xx宿舍”而丢失楼栋号。\r\n  {\r\n    const isDorm = \/(宿舍|宿舍楼|宿舍樓|宿舍区|宿舍區)\/.test(t);\r\n    if (isDorm) {\r\n      if (\/\\d+\\s*[号號]\\s*[楼樓]\/.test(t)) return false;\r\n      if (\/[A-Za-z0-9一二三四五六七八九十两兩]+\\s*[栋棟幢]\/.test(t)) return false;\r\n      if (\/(?:单元|單元|座|梯)\/.test(t)) return false;\r\n    }\r\n  }\r\n\r\n  \/\/ 便利店\/超市\/药房等：若文本已包含门牌\/楼栋\/房号，则优先走门牌裁剪逻辑，避免丢失精确地址\r\n  {\r\n    const isStorePoi = \/(便利店|超市|药房|药店)\/.test(t);\r\n    if (isStorePoi) {\r\n      const hasAddressMarkers =\r\n        \/\\d+\\s*[号號](?:\\s*之\\s*\\d+)?\/.test(t) ||\r\n        \/\\d+\\s*[号號]\\s*[楼樓]\/.test(t) ||\r\n        \/[栋棟]|(单元|單元)|室|层|層|座|梯\/.test(t);\r\n      if (hasAddressMarkers) return false;\r\n    }\r\n  }\r\n\r\n  \/\/ 常见门店格式：带 (XX店)\/(XX分店) 或以“店”结尾\r\n  const hasStoreSuffix = \/[（(][^（）()]{1,20}(店|分店)[)）]$\/.test(t) || \/(店|分店)$\/.test(t);\r\n  if (hasStoreSuffix) return true;\r\n\r\n  \/\/ 场所可能不带“(XX店)”，但本身即 POI（尽量限制长度避免误判）\r\n  if (\r\n    \/(网吧|网咖|电竞馆|电竞|棋牌室|台球|会所|酒吧|KTV|ktv|住院部|门诊|急诊|体检中心|营业厅|驿站|充电站)\/.test(t) &&\r\n    t.length <= 32\r\n  )\r\n    return true;\r\n\r\n  \/\/ 便利店\/超市\/药房等 POI：允许不带“(XX店)”括号，直接作为配送点（限制长度避免误判）\r\n  if (\/(便利店|超市|药房|药店)\/.test(t) && t.length <= 32) return true;\r\n\r\n  return false;\r\n}\r\n\r\nfunction extractKeyDeliveryPoiPrefix(text) {\r\n  \/\/ 从“顾客地址”里截出关键配送点 POI 名称（去掉后面的楼层\/房号\/备注）\r\n  \/\/ 例如：金色四季酒店(长青路店)12楼xx -> 金色四季酒店(长青路店)\r\n  \/\/       胡小鸭共享棋牌室(软件园二期)（1号包厢） -> 胡小鸭共享棋牌室(软件园二期)\r\n  \/\/       明发商业广场-北区（141号新旺嘉便利店） -> 明发商业广场-北区（新旺嘉便利店）\r\n  const t = normalizeText(text);\r\n  if (!t) return null;\r\n\r\n  \/\/ 分店\/园区\/小区等信息（不强制包含“店”）\r\n  \/\/ 但不要把“4层\/13楼\/负一楼”等楼层括号当成 POI 的一部分\r\n  const branchParen = \/(?:[（(](?!\\s*(?:负?\\d+|B\\d+|[一二三四五六七八九十\\d]+)\\s*(?:楼|樓|层|層|F|f))[^（）()]{1,20}[)）])?\/;\r\n\r\n  function cleanParenHints(s) {\r\n    \/\/ 清理括号内常见引导词\/楼层信息，保留真正的配送点名称\r\n    \/\/ 例：联发文创口岸7号楼（二楼呷咪电竞馆前台） -> 联发文创口岸7号楼（呷咪电竞馆）\r\n    return String(s).replace(\/[（(]([^（）()]*)[)）]\/g, (m0, inner) => {\r\n      let x = String(inner).trim();\r\n      \/\/ 去掉开头楼层\/区域提示\r\n      x = x.replace(\/^(?:负?\\d+|B\\d+|[一二三四五六七八九十\\d]+)\\s*(?:楼|樓|层|層)\\s*\/i, '');\r\n      x = x.replace(\/^(?:上楼|楼上|楼下|上去|下去)\\s*\/i, '');\r\n      \/\/ 去掉结尾引导词\r\n      x = x.replace(\/(前台|门口|大门|大厅|电梯口|楼梯口|旁边|对面|附近|路边|侧门|北门|南门|东门|西门)\\s*$\/i, '');\r\n      x = x.trim();\r\n      \/\/ 如果括号内容只剩星号\/空白（例如“（4层***）”），直接移除该括号段\r\n      if (!x || \/^[*＊]+$\/.test(x)) return '';\r\n      \/\/ 用全角括号统一输出\r\n      return `（${x}）`;\r\n    }).replace(\/\\s+\/g, ' ').trim();\r\n  }\r\n\r\n  \/\/ 1) “xx店(分店名)” 这种通用门店格式（常见配送点）\r\n  const reStore = new RegExp(`^(.+?(?:店|分店)${branchParen.source})`);\r\n  const m1 = t.match(reStore);\r\n  if (m1 && m1[1] && m1[1].trim().length >= 3) {\r\n    \/\/ 去掉括号内“门牌号”前缀（例如： （141号新旺嘉便利店） -> （新旺嘉便利店））\r\n    const s1 = m1[1]\r\n      .trim()\r\n      .replace(\/([（(])\\s*\\d+\\s*[号號]\\s*\/g, '$1')\r\n      .replace(\/([（(])\\s*\\d+\\s*[号號]\\s*(?:之\\s*\\d+\\s*)?\/g, '$1')\r\n      .trim();\r\n    \/\/ 清理括号内“门口\/前台”等引导词：如“邻丫便利店（门口）” -> “邻丫便利店”\r\n    return cleanParenHints(s1);\r\n  }\r\n\r\n  \/\/ 2) 关键场所关键词（酒店\/网咖\/电竞\/棋牌室\/会所\/台球\/KTV\/医院住院部...），允许带任意括号分区信息\r\n  const rePoi = new RegExp(`^(.+?${KEY_DELIVERY_POI_RE.source}${branchParen.source})`);\r\n  const m2 = t.match(rePoi);\r\n  if (m2 && m2[1] && m2[1].trim().length >= 3) {\r\n    let s = m2[1]\r\n      .trim()\r\n      .replace(\/([（(])\\s*\\d+\\s*[号號]\\s*\/g, '$1')\r\n      .replace(\/([（(])\\s*\\d+\\s*[号號]\\s*(?:之\\s*\\d+\\s*)?\/g, '$1')\r\n      .trim();\r\n\r\n    \/\/ 若截断点落在括号内（导致未闭合），补齐到最近的右括号\r\n    const leftCount = (s.match(\/[（(]\/g) || []).length;\r\n    const rightCount = (s.match(\/[)）]\/g) || []).length;\r\n    if (leftCount > rightCount) {\r\n      const closeIdx = t.indexOf('）', s.length);\r\n      const closeIdx2 = t.indexOf(')', s.length);\r\n      const idx = closeIdx >= 0 && closeIdx2 >= 0 ? Math.min(closeIdx, closeIdx2) : Math.max(closeIdx, closeIdx2);\r\n      if (idx >= 0 && idx - s.length <= 24) {\r\n        s = t.slice(0, idx + 1).trim();\r\n      }\r\n    }\r\n\r\n    return cleanParenHints(s);\r\n  }\r\n\r\n  return null;\r\n}\r\n\r\nfunction extractAddressCore(addr) {\r\n  \/\/ 目标：保留到“X号\/号楼\/栋\/座\/单元\/梯”为止，后续楼层\/房号\/备注等截断\r\n  \/\/ 若完全匹配不到常见格式，则返回原文（便于人工确认）\r\n  const raw = cleanCustomerAddress(addr);\r\n  if (!raw) return { core: '', matched: false };\r\n\r\n  \/\/ 统一空格：例如“莲前东路 288 号 1155 室”\r\n  const s = raw.replace(\/\\s+\/g, ' ').trim();\r\n\r\n  function finalizeCore(core, matched) {\r\n    let c = normalizeText(core).replace(\/\\s+\/g, ' ').trim();\r\n    \/\/ 部分楼栋\/门牌会被 UI 包在括号里：过滤括号字符，但保留括号内文本\r\n    \/\/ 仅在“像地址关键段”出现时处理，避免误伤 POI 分店名括号等场景\r\n    if (\/[号號]\/.test(c) || \/[楼樓]\/.test(c) || \/[栋棟]\/.test(c)) {\r\n      c = c.replace(\/[（）()]\/g, '').replace(\/\\s+\/g, ' ').trim();\r\n    }\r\n    return { core: c, matched: !!matched };\r\n  }\r\n\r\n  \/\/ “范围号楼 + 真实门牌号”优先：出现“384-388号楼”同时后面出现“388号xxx室”时，\r\n  \/\/ 更适合导航的是最后的真实门牌号（例如“屿后南里388号”），而不是范围号楼。\r\n  \/\/ 例：屿后南里384-388号楼388号202室 -> 屿后南里388号\r\n  {\r\n    const m = s.match(\/^(.*?)(\\d+)\\s*[-—－]\\s*(\\d+)\\s*[号號]\\s*[楼樓]\/);\r\n    if (m && m[2] && m[3]) {\r\n      const prefix = String(m[1] || '').trim();\r\n      const upper = String(m[3]).trim();\r\n      const rest = s.slice(m[0].length);\r\n      \/\/ upper号 必须出现在号楼后面，且不是“号楼\/号线”\r\n      if (new RegExp(`\\\\b${upper}\\\\s*[号號](?!\\\\s*(?:[楼樓]|线))`).test(rest)) {\r\n        const core = `${prefix}${upper}号`.trim();\r\n        if (core.length >= 2) return finalizeCore(core, true);\r\n      }\r\n    }\r\n  }\r\n\r\n  \/\/ “更精确楼栋”优先：当文本里出现多个“X号楼”，且后半段包含“楼盘\/小区名-某号楼”时，\r\n  \/\/ 通常后者更适合导航（例如前面是片区\/路段门牌范围，后面才是小区\/楼栋）。\r\n  \/\/ 例：福建厦门市...金山西二里288-289号楼山谷城市-289号楼8层***室 -> 山谷城市-289号楼\r\n  {\r\n    const re = \/([\\u4e00-\\u9fa5A-Za-z0-9·]{2,30})\\s*([-—－])\\s*(\\d+)\\s*[号號]\\s*[楼樓]\/g;\r\n    const ms = [];\r\n    try {\r\n      for (const m of s.matchAll(re)) {\r\n        if (!m || !m[1] || !m[2] || !m[3]) continue;\r\n        ms.push(m);\r\n      }\r\n    } catch (_) {\r\n      \/\/ ignore\r\n    }\r\n    if (ms.length) {\r\n      const last = ms[ms.length - 1];\r\n      const name = String(last[1]).trim();\r\n      const sep = String(last[2]).trim(); \/\/ '-', '—', '－'\r\n      const num = String(last[3]).trim();\r\n      const core = `${name}${sep}${num}号楼`.trim();\r\n      if (core.length >= 2) return finalizeCore(core, true);\r\n    }\r\n  }\r\n\r\n  \/\/ “XXX-XXX号小区”保留：这类通常是小区\/片区的门牌范围，导航时应整体保留\r\n  \/\/ 例：金山西二里288-289号小区 -> 金山西二里288-289号小区\r\n  \/\/ 例：山谷城市-289号小区 -> 山谷城市-289号小区\r\n  {\r\n    const re =\r\n      \/([\\u4e00-\\u9fa5A-Za-z0-9·]{2,30})\\s*([-—－])\\s*(\\d+(?:\\s*[-—－]\\s*\\d+)?)\\s*[号號]\\s*(小区|小區)\/g;\r\n    const ms = [];\r\n    try {\r\n      for (const m of s.matchAll(re)) {\r\n        if (!m || !m[1] || !m[2] || !m[3] || !m[4]) continue;\r\n        ms.push(m);\r\n      }\r\n    } catch (_) {\r\n      \/\/ ignore\r\n    }\r\n    if (ms.length) {\r\n      const last = ms[ms.length - 1];\r\n      const name = String(last[1]).trim();\r\n      const sep = String(last[2]).trim();\r\n      const range = String(last[3]).replace(\/\\s+\/g, '').trim();\r\n      const suffix = String(last[4]).trim();\r\n      const core = `${name}${sep}${range}号${suffix}`.trim();\r\n      if (core.length >= 2) return finalizeCore(core, true);\r\n    }\r\n  }\r\n\r\n  \/\/ 医院\/住院部：常见配送点，优先截到“医院(可选住院部\/门诊\/急诊\/体检中心)”为止\r\n  \/\/ 并且：如果后面紧跟“6号楼”这种楼栋号，也一起带上，方便导航\r\n  \/\/ 例：XX医院住院部6号楼3层... -> XX医院住院部6号楼\r\n  \/\/ 例：XX医院（29楼） -> XX医院\r\n  {\r\n    const m = s.match(\/^(.*?医院(?:[^（）()]*)?(?:住院部|门诊|急诊|体检中心)?)\/);\r\n    if (m && m[1] && m[1].trim().length >= 2) {\r\n      const core = appendFollowingHaoLou(s, m[1].trim());\r\n      return finalizeCore(core, true);\r\n    }\r\n  }\r\n\r\n  \/\/ “蓝色门牌号”场景：括号\/文本里出现“30号3号楼2303”这种双“号”，\r\n  \/\/ 通常第一个“30号”是门牌提示（地图不一定好匹配），应优先取后面的“3号楼”\r\n  \/\/ 例：湖边湾璟A区（30号3号楼2303） -> 湖边湾璟A区3号楼\r\n  {\r\n    const m = s.match(\r\n      \/^(.*?)(?:[（(]\\s*)?\\d+\\s*[号號]\\s*(\\d+)\\s*[号號]\\s*[楼樓]\/\r\n    );\r\n    if (m && m[1] && m[2]) {\r\n      const prefix = String(m[1]).replace(\/[（(]\\s*$\/, '').trim();\r\n      const core = `${prefix}${m[2]}号楼`.trim();\r\n      if (core.length >= 2) return finalizeCore(core, true);\r\n    }\r\n  }\r\n\r\n  \/\/ “A幢\/B幢”：幢\/棟 类楼栋标识，优先截断到“X幢”为止\r\n  \/\/ 例：旸鑫公寓（A幢5层***） -> 旸鑫公寓A幢\r\n  {\r\n    const m = s.match(\/^(.*?)(?:[（(]\\s*)?([A-Za-z0-9一二三四五六七八九十两兩]+)\\s*[幢棟]\/);\r\n    if (m && m[1] && m[2]) {\r\n      const prefix = String(m[1]).replace(\/[（(]\\s*$\/, '').trim();\r\n      const core = `${prefix}${m[2]}幢`.trim();\r\n      if (core.length >= 2) return finalizeCore(core, true);\r\n    }\r\n  }\r\n\r\n  \/\/ “xx中心（外卖柜\/前台\/门口...）”：按需求截断到“中心”为止\r\n  \/\/ 例：鼎丰财富中心（外卖柜） -> 乐丰财富中心\r\n  \/\/ 例：XX中心（XX店） -> XX中心（XX店）\r\n  \/\/ 仅在“中心”后面直接跟括号（或结尾）时生效，避免误伤“中心B座”等结构，但允许“中心(XX店)”\r\n  {\r\n    \/\/ 先尝试匹配\"中心(XX店)\"格式\r\n    const mStore = s.match(\/^(.*?中心)\\s*[（(][^）()]{0,30}店[)）]\/);\r\n    if (mStore && mStore[1] && mStore[1].trim().length >= 2) {\r\n      const fullMatch = mStore[0].trim();\r\n      return finalizeCore(fullMatch, true);\r\n    }\r\n    \/\/ 再匹配\"中心\"后面跟括号或结尾（原有逻辑）\r\n    const m = s.match(\/^(.*?中心)\\s*(?=[（(]|$)\/);\r\n    if (m && m[1] && m[1].trim().length >= 2) return finalizeCore(m[1].trim(), true);\r\n  }\r\n\r\n  \/\/ “商务楼”优先：顾客地址出现商务楼时，直接裁剪到商务楼为止\r\n  \/\/ 目的：避免后面跟公司名时把 POI 搞混（例如美团 POI 识别）\r\n  \/\/ 例：XX商务楼XX公司... -> XX商务楼\r\n  {\r\n    \/\/ 兼容简繁混用：商\/務 + 楼\/樓\r\n    const m = s.match(\/^(.*?商[务務][楼樓])\/);\r\n    if (m && m[1] && m[1].trim().length >= 2) return finalizeCore(m[1].trim(), true);\r\n  }\r\n\r\n  \/\/ 教育机构 + 校区\/分校\/分园：这是典型可导航 POI，常见后面跟\"·接力送站点\/门口\/保安室\"等说明\r\n  \/\/ 例：厦门海洋职业技术学院（思明校区）·接力送站点 -> 厦门海洋职业技术学院（思明校区）\r\n  \/\/ 例：XX大学思明校区 北门 -> XX大学（思明校区）北门\r\n  \/\/ 例：XX小学（思明校区）·站点 -> XX小学（思明校区）\r\n  \/\/ 例：XX幼儿园（XX分园）门口 -> XX幼儿园（XX分园）\r\n  \/\/ 例：信成火炬学校(西南门) -> 信成火炬学校（西南门）\r\n  {\r\n    \/\/ 注意：避免在\"路线\/备注\"里提到幼儿园\/学校时误命中（例如：...174号...（从松柏幼儿园南门进入））\r\n    \/\/ 仅当教育机构名称出现在地址开头附近，并且其前面没有门牌\/数字信息时才触发。\r\n    const eduRe =\r\n      \/(大学|学院|学校|小学|中学|初中|高中|幼儿园|幼稚园|職校|职校|技校|职业学校|職業學校|职业技术学校|职业技术学院|职业技校)\/;\r\n    const idx = s.search(eduRe);\r\n    if (idx >= 0 && idx <= 20 && !\/[0-9号號]\/.test(s.slice(0, idx))) {\r\n      const mEdu = s.slice(idx).match(eduRe);\r\n      const kw = mEdu ? String(mEdu[0]) : '';\r\n      const base = kw ? s.slice(0, idx + kw.length).trim() : '';\r\n      if (base && base.length <= 50 && !\/[0-9号號]\/.test(base)) {\r\n        const rest = s.slice(idx + kw.length);\r\n        const campusSuffixRe = \/(校区|校區|分校|分園|分园)\/;\r\n\r\n        \/\/ 定义\"XX门\"的正则表达式（避免重复）\r\n        \/\/ 支持：北门、南门、东门、西门、西南门、东北门、东南门、西北门、正门、后门、侧门、大门等\r\n        \/\/ 注意：[东西南北]{1,2}会匹配单个方向（东、南、西、北）和组合方向（东南、东北、西南、西北）\r\n        const doorRe = \/((?:[东西南北]{1,2}|正|后|侧)门|大门)\/;\r\n        const doorParenRe = \/^\\s*[（(]\\s*((?:[东西南北]{1,2}|正|后|侧)门|大门)\\s*[)）]\/;\r\n\r\n        \/\/ 括号内校区\/分校\/分园\r\n        const mParen = rest.match(\/^\\s*[（(]\\s*([^（）()]{1,40}(?:校区|校區|分校|分園|分园))\\s*[)）]\/);\r\n        \/\/ 非括号紧跟校区\/分校\/分园（例如\"思明校区\"）\r\n        const mPlain = rest.match(\/^\\s*([^（）()·•・]{1,40}(?:校区|校區|分校|分園|分园))\/);\r\n        const campus = mParen?.[1]\r\n          ? String(mParen[1]).trim()\r\n          : mPlain?.[1] && campusSuffixRe.test(mPlain[1])\r\n            ? String(mPlain[1]).trim()\r\n            : '';\r\n\r\n        \/\/ 校区地址处理：先检查是否有校区，然后检查是否有\"XX门\"\r\n        let core = '';\r\n        let afterCampus = '';\r\n        \r\n        if (campus) {\r\n          \/\/ 有校区：先构建校区地址，然后检查后面是否有\"XX门\"\r\n          core = `${base}（${campus}）`;\r\n          afterCampus = mParen\r\n            ? rest.slice(mParen[0].length)\r\n            : mPlain\r\n              ? rest.slice(mPlain[0].length)\r\n              : '';\r\n        } else {\r\n          \/\/ 没有校区：直接检查教育机构后面是否有\"XX门\"\r\n          core = base;\r\n          afterCampus = rest;\r\n        }\r\n        \r\n        \/\/ 检查校区地址后面是否有\"XX门\"（使用统一的正则变量）\r\n        \/\/ 先尝试匹配括号内的门：如\"(西南门)\"\r\n        const mDoorParen = afterCampus.match(doorParenRe);\r\n        \/\/ 再尝试匹配非括号的门：如\" 西南门\"\r\n        const mDoorPlain = afterCampus.trim().match(doorRe);\r\n        \r\n        if (mDoorParen && mDoorParen[1]) {\r\n          \/\/ 括号内的门，保留括号格式\r\n          core = `${core}（${mDoorParen[1]}）`;\r\n        } else if (mDoorPlain && mDoorPlain[1]) {\r\n          \/\/ 非括号的门，直接追加\r\n          core = `${core}${mDoorPlain[1]}`;\r\n        }\r\n        \/\/ 如果没有匹配到\"XX门\"，core保持原样（只保留校区或教育机构名称）\r\n        \r\n        if (core.length >= 2) return finalizeCore(core, true);\r\n      }\r\n    }\r\n  }\r\n\r\n  \/\/ 公司\/机构名 + “X厂\/ X号”优先：当公司名后面紧跟“二厂\/3厂\/5号”等信息时，\r\n  \/\/ 这些信息通常是精确定位点（厂区\/门牌），应保留到此为止，丢弃后续“门卫室旁边\/不用打电话”等备注。\r\n  \/\/ 例：贝莱胜电子(厦门)有限公司-二厂(东北门)门卫室旁边(不用打电话，接不到) -> 贝莱胜电子(厦门)有限公司-二厂\r\n  \/\/ 例：XX有限公司 3厂（北门） -> XX有限公司3厂\r\n  \/\/ 例：XX公司-5号（门口） -> XX公司-5号\r\n  {\r\n    const m = s.match(new RegExp(`^(.*?${ORG_SUFFIX_RE.source})`));\r\n    if (m && m[1] && m[1].trim().length >= 2) {\r\n      const prefix = String(m[1]).trim();\r\n      const rest = s.slice(m[0].length);\r\n\r\n      \/\/ 工厂编号：二厂\/3厂\/第3厂\r\n      const mFactory = rest.match(\/^\\s*(?:[-—－]\\s*)?(?:第\\s*)?([一二三四五六七八九十两兩0-9]{1,3})\\s*厂\/);\r\n      if (mFactory && mFactory[0]) {\r\n        \/\/ 保留分隔符“-”以贴近原文（如果原文本有）\r\n        const hasSep = \/^\\s*[-—－]\/.test(rest);\r\n        const core = `${prefix}${hasSep ? '-' : ''}${String(mFactory[1]).trim()}厂`.trim();\r\n        if (core.length >= 2) return finalizeCore(core, true);\r\n      }\r\n\r\n      \/\/ 门牌号：5号（不匹配地铁1号线）\r\n      const mHao = rest.match(\/^\\s*(?:[-—－]\\s*)?(\\d+(?:\\s*[-—－]\\s*\\d+)?)\\s*[号號](?!线)\/);\r\n      if (mHao && mHao[1]) {\r\n        const hasSep = \/^\\s*[-—－]\/.test(rest);\r\n        const num = String(mHao[1]).replace(\/\\s+\/g, '');\r\n        const core = `${prefix}${hasSep ? '-' : ''}${num}号`.trim();\r\n        if (core.length >= 2) return finalizeCore(core, true);\r\n      }\r\n    }\r\n  }\r\n\r\n  \/\/ 公司\/机构名 + “办公楼\/公寓楼\/写字楼\/宿舍楼”：公司后面紧跟楼宇类型时应保留到楼宇为止\r\n  \/\/ 例：金湖路船务公司综合办公楼9层***室 -> 金湖路船务公司综合办公楼\r\n  \/\/ 例：XX公司-办公楼（北门） -> XX公司-办公楼\r\n  \/\/ 例：XX公司公寓楼3层 -> XX公司公寓楼\r\n  {\r\n    const m = s.match(\r\n      new RegExp(\r\n        `^(.*?${ORG_SUFFIX_RE.source})\\\\s*(?:[-—－]\\\\s*)?((?:综合)?(?:办公楼|辦公樓|公寓楼|公寓樓|写字楼|寫字樓|宿舍楼|宿舍樓))`\r\n      )\r\n    );\r\n    if (m && m[1] && m[2]) {\r\n      const prefix = String(m[1]).trim();\r\n      const building = String(m[2]).trim();\r\n      \/\/ 如果原文确实有分隔符“-”，尽量保留\r\n      const hasSep = new RegExp(`^(.*?${ORG_SUFFIX_RE.source})\\\\s*[-—－]`).test(s);\r\n      const core = `${prefix}${hasSep ? '-' : ''}${building}`.trim();\r\n      if (core.length >= 2) return finalizeCore(core, true);\r\n    }\r\n  }\r\n\r\n  \/\/ 企业\/机构名称：去掉公司名后面的楼层括号等冗余\r\n  {\r\n    const trimmed = trimCompanyFloorParen(s);\r\n    if (trimmed !== s && trimmed.length >= 2) return finalizeCore(trimmed, true);\r\n  }\r\n\r\n  \/\/ 配送点为“某店”且后面跟了括号补充信息时：只保留“店名(分店)”这一段\r\n  \/\/ 例：青云隆超市(中埔路店)（厦商公寓2层*** 密码789789） -> 青云隆超市(中埔路店)\r\n  {\r\n    const m = s.match(\/^(.+?[（(][^（）()]{1,40}店[)）])\/);\r\n    if (m && m[1] && m[1].trim().length >= 2) return finalizeCore(m[1].trim(), true);\r\n  }\r\n\r\n  \/\/ 地铁站：通常需要精确到“X号口\/號口”为止\r\n  \/\/ 例：xx地铁站1号口xxx -> xx地铁站1号口\r\n  {\r\n    const m = s.match(\/^(.*?地铁.*?站)\\s*([0-9一二三四五六七八九十]+)\\s*[号號]\\s*口\/);\r\n    if (m && m[1] && m[2]) {\r\n      const cn = {\r\n        一: '1',\r\n        二: '2',\r\n        三: '3',\r\n        四: '4',\r\n        五: '5',\r\n        六: '6',\r\n        七: '7',\r\n        八: '8',\r\n        九: '9',\r\n        十: '10'\r\n      };\r\n      const n = String(m[2]);\r\n      const num = cn[n] ?? n;\r\n      const core = `${m[1].trim()}${num}号口`;\r\n      if (core.length >= 2) return finalizeCore(core, true);\r\n    }\r\n  }\r\n\r\n  \/\/ 若文本本身已包含\"X号楼\/號樓\"等楼栋关键段，则优先截断到楼栋为止，\r\n  \/\/ 不走 POI 关键词逻辑（例如：联发文创口岸7号楼（二楼呷咪电竞馆前台） -> 联发文创口岸7号楼）\r\n  {\r\n    const m = s.match(\/^(.*?\\d+\\s*[号號]\\s*[楼樓])\/);\r\n    if (m && m[1] && m[1].trim().length >= 2) {\r\n      const base = m[1].trim();\r\n      const rest = s.slice(m[0].length);\r\n\r\n      \/\/ 兼容：号楼后面紧跟 \"B栋\/棟\"（可能在括号里），需要一并保留\r\n      \/\/ 例：塘边社10号楼（B栋610） -> 塘边社10号楼B栋\r\n      \/\/ 例：塘边社10号楼B栋610 -> 塘边社10号楼B栋\r\n      const m2 = rest.match(\/^\\s*(?:[（(]\\s*)?([A-Za-z0-9一二三四五六七八九十两兩]+)\\s*([栋棟])\/);\r\n      if (m2 && m2[1] && m2[2]) {\r\n        const core = `${base}${String(m2[1]).trim()}${String(m2[2]).trim()}`.trim();\r\n        if (core.length >= 2) return finalizeCore(core, true);\r\n      }\r\n\r\n      return finalizeCore(base, true);\r\n    }\r\n  }\r\n\r\n  \/\/ 若文本本身已包含\"X栋\/棟\"等楼栋关键段，则优先截断到楼栋为止\r\n  \/\/ 例：永欣缘川菜4014栋****9号公馆 -> 永欣缘川菜4014栋\r\n  \/\/ 避免后面的\"号公馆\"被错误匹配\r\n  \/\/ 注意：这里匹配的是\"数字+栋\"或\"字母+数字+栋\"的形式，如\"4014栋\"、\"A1栋\"\r\n  {\r\n    const m = s.match(\/^(.*?[A-Za-z0-9一二三四五六七八九十两兩]+\\s*[栋棟])\/);\r\n    if (m && m[1] && m[1].trim().length >= 2) {\r\n      const base = m[1].trim();\r\n      const rest = s.slice(m[0].length);\r\n      \r\n      \/\/ 如果\"X栋\"后面紧跟\"号公馆\"、\"号公寓\"等，应该截断到\"X栋\"为止\r\n      \/\/ 因为\"号公馆\"是另一个地址部分，不应该包含在\"X栋\"的地址中\r\n      \/\/ 检查后面是否有\"号公馆\"、\"号公寓\"等建筑后缀\r\n      if (\/^\\s*[*\\s]*\\d+\\s*[号號]\\s*(?:公馆|公館|公寓|小区|小區|花园|花園|家园|家園|大厦|大廈|中心|广场|廣場|写字楼|寫字樓|大楼|大樓)\/.test(rest)) {\r\n        return finalizeCore(base, true);\r\n      }\r\n      \r\n      \/\/ 如果\"X栋\"后面没有明确的地址信息，也截断到\"X栋\"\r\n      return finalizeCore(base, true);\r\n    }\r\n  }\r\n\r\n  \/\/ POI 关键配送点优先：精准截到 POI 名称（去掉后面的楼层\/备注）\r\n  if (isKeyDeliveryPoi(s)) {\r\n    const poiPrefix = extractKeyDeliveryPoiPrefix(s);\r\n    return finalizeCore(poiPrefix || s, true);\r\n  }\r\n\r\n  \/\/ “门牌号 + 建筑后缀”场景：号后紧跟“公寓\/小区\/花园\/大厦\/公馆...”时要把后缀一并保留\r\n  \/\/ 例：75号公寓（6层***） -> 75号公寓\r\n  \/\/ 例：xx路75号公寓 -> xx路75号公寓\r\n  \/\/ 例：九号公馆 -> 9号公馆（保留公馆后缀）\r\n  {\r\n    const m = s.match(\r\n      \/^(.*?\\d+\\s*[号號](?:\\s*之\\s*\\d+)?\\s*(?:公寓|小区|小區|花园|花園|家园|家園|大厦|大廈|中心|广场|廣場|写字楼|寫字樓|大楼|大樓|公馆|公館))\/\r\n    );\r\n    if (m && m[1] && m[1].trim().length >= 2) return finalizeCore(m[1].trim(), true);\r\n  }\r\n\r\n  \/\/ 公寓类：如果\"XX公寓\"后面没有楼栋号（如\"XX公寓1号楼\"），则过滤掉\r\n  \/\/ 例：龙景公寓一楼*** -> 过滤（只有楼层，没有楼栋号）\r\n  \/\/ 例：龙景公寓1层*** -> 过滤（只有楼层，没有楼栋号）\r\n  \/\/ 例：龙景公寓1号楼 -> 龙景公寓1号楼（有楼栋号，保留）\r\n  \/\/ 注意：单独的\"X楼\"或\"X层\"是楼层信息，不是楼栋号，应该过滤\r\n  {\r\n    const idx = s.search(\/公寓\/);\r\n    if (idx >= 0) {\r\n      const beforeApartment = s.slice(0, idx);\r\n      const afterApartment = s.slice(idx + 2); \/\/ \"公寓\"是2个字\r\n      \r\n      \/\/ 先检查是否只有楼层信息（X楼或X层），如果是则明确过滤\r\n      const onlyFloorInfo = \/^\\s*(?:[（(]\\s*)?[0-9０-９一二三四五六七八九十两兩]+\\s*[楼樓](?!号|號)\/.test(afterApartment) ||\r\n        \/^\\s*(?:[（(]\\s*)?[0-9０-９一二三四五六七八九十两兩]+\\s*层\/.test(afterApartment);\r\n      \r\n      if (onlyFloorInfo) {\r\n        \/\/ 只有楼层信息，没有楼栋号，过滤掉（不返回，继续后续规则处理）\r\n        \/\/ 不返回，让后续规则处理\r\n      } else {\r\n        \/\/ 检查后面是否有真正的楼栋号：号楼\/栋\/座\/单元\/梯\r\n        const hasBuildingNumber = \/^\\s*(?:[（(]\\s*)?\\d+\\s*[号號]\\s*[楼樓]\/.test(afterApartment) ||\r\n          \/^\\s*(?:[（(]\\s*)?[A-Za-z0-9一二三四五六七八九十两兩]+\\s*[栋棟]\/.test(afterApartment) ||\r\n          \/^\\s*(?:[（(]\\s*)?(?:第\\s*)?[0-9０-９一二三四五六七八九十两兩A-Za-z,，、\\- ]+座\/.test(afterApartment) ||\r\n          \/^\\s*(?:[（(]\\s*)?\\d+\\s*(?:单元|單元)\/.test(afterApartment) ||\r\n          \/^\\s*(?:[（(]\\s*)?\\d+\\s*梯\/.test(afterApartment);\r\n        \r\n        if (!hasBuildingNumber) {\r\n          \/\/ 没有楼栋号，过滤掉（不返回，继续后续规则处理）\r\n          \/\/ 不返回，让后续规则处理\r\n        } else {\r\n          \/\/ 有楼栋号，保留到楼栋号为止\r\n          const mBuilding = afterApartment.match(\/^\\s*(?:[（(]\\s*)?(\\d+\\s*[号號]\\s*[楼樓]|[A-Za-z0-9一二三四五六七八九十两兩]+\\s*[栋棟]|(?:第\\s*)?[0-9０-９一二三四五六七八九十两兩A-Za-z,，、\\- ]+座|\\d+\\s*(?:单元|單元)|\\d+\\s*梯)\/);\r\n          if (mBuilding && mBuilding[1]) {\r\n            const core = `${beforeApartment}公寓${mBuilding[1]}`.trim();\r\n            if (core.length >= 2) return finalizeCore(core, true);\r\n          }\r\n        }\r\n      }\r\n    }\r\n  }\r\n\r\n  \/\/ 大厦类：按需求\"直接忽略大厦后面的\"，但如果包含\"第X座\/第2、3座\"则保留到座为止\r\n  \/\/ 例：中国人寿大厦（10层***） -> 中国人寿大厦\r\n  \/\/ 例：中骏大厦第2、3座 -> 中骏大厦第2、3座\r\n  {\r\n    \/\/ 兼容不带“第”：如“中骏大厦2、3座”\r\n    const m = s.match(\r\n      \/^(.*?(?:大厦|大廈))\\s*((?:第\\s*)?[0-9０-９一二三四五六七八九十两兩A-Za-z,，、\\- ]+座)\/\r\n    );\r\n    if (m && m[1] && m[2]) {\r\n      const core = (m[1] + m[2].replace(\/\\s+\/g, '')).trim();\r\n      if (core.length >= 2) return finalizeCore(core, true);\r\n    }\r\n    const idx = s.search(\/大厦|大廈\/);\r\n    if (idx >= 0) {\r\n      const core = s.slice(0, idx + 2).trim(); \/\/ 大厦\/大廈 都是 2 字\r\n      if (core.length >= 2) return finalizeCore(core, true);\r\n    }\r\n  }\r\n\r\n  \/\/ 先把可能的“备注\/逗号\/分号”后半段排除，避免把后续描述一起算进来\r\n  \/\/ 注意：不要在遇到括号就截断，因为很多小区名会用括号包裹门牌号（如：樱花山庄（圆山北路77号6层...））\r\n  const stopAt = (() => {\r\n    const m = s.match(\/[，,;；]\/);\r\n    return m ? m.index : s.length;\r\n  })();\r\n  const head = s.slice(0, stopAt);\r\n\r\n  \/\/ 需要支持的形式（示例）：\r\n  \/\/ - 288号\r\n  \/\/ - A号 \/ B号（连续出现时保留到最后一个）\r\n  \/\/ - 21号楼 \/ 21-1号楼 \/ A栋 \/ B栋 \/ 2单元 \/ 1梯 \/ 3座 \/ 6楼\r\n  \/\/ - 288号之九\r\n  \/\/ 同时尽量避免误伤：如“地铁1号线”（号后跟“线”不算门牌号）\r\n  \/\/ 注意：这里**不匹配“XX楼\/XX樓”**（楼层），避免把“22楼往上走半层”当成截断点；\r\n  \/\/ 但要保留“XX号楼\/XX號樓”（楼栋），所以仍包含“号楼\/號樓”\r\n  \/\/ 兼容繁体：號\/樓\/棟\/單元\r\n  const haoChar = '[号號]';\r\n  const louChar = '[楼樓]';\r\n  const dongChar = '[栋棟]';\r\n  const danYuanChar = '(?:单元|單元)';\r\n  const reNoHao = new RegExp(\r\n    `[A-Za-z0-9]+(?:-[A-Za-z0-9]+)?\\\\s*(?:${haoChar}${louChar}|${dongChar}|座|梯|${danYuanChar})`,\r\n    'g'\r\n  );\r\n  const reHao = new RegExp(\r\n    `[A-Za-z0-9]+(?:-[A-Za-z0-9]+)?\\\\s*${haoChar}(?:\\\\s*之\\\\s*\\\\d+)?(?!线)`,\r\n    'g'\r\n  );\r\n\r\n  const matches = [];\r\n  for (const re of [reNoHao, reHao]) {\r\n    try {\r\n      for (const m of head.matchAll(re)) {\r\n        if (!m) continue;\r\n        const start = m.index ?? -1;\r\n        if (start < 0) continue;\r\n        matches.push({ start, end: start + m[0].length });\r\n      }\r\n    } catch (_) {\r\n      \/\/ ignore\r\n    }\r\n  }\r\n\r\n  \/\/ 兜底：没有“号\/栋\/号楼\/单元\/梯”等关键段时，尝试识别“楼座\/楼层代号”一类的简写\r\n  \/\/ 例：金禾河广场1A1101室 -> 截到 “金禾河广场1A”\r\n  if (!matches.length) {\r\n    const m = head.match(\/^(.*?)(\\d+[A-Za-z])(?=\\s*-?\\s*\\d{2,}\\s*(?:室|号房|房|铺|店)?)\/);\r\n    if (m && m[2]) {\r\n      const core = (m[1] + m[2]).trim();\r\n      if (core.length >= 2) return finalizeCore(core, true);\r\n    }\r\n    const m2 = head.match(\/^(.*?)(\\d+[A-Za-z])(?=\\s*(?:室|号房|房|铺|店))\/);\r\n    if (m2 && m2[2]) {\r\n      const core = (m2[1] + m2[2]).trim();\r\n      if (core.length >= 2) return finalizeCore(core, true);\r\n    }\r\n    return finalizeCore(s, false);\r\n  }\r\n  matches.sort((a, b) => a.start - b.start || a.end - b.end);\r\n\r\n  \/\/ 取第一段匹配开始，向后合并“连续片段”（解决 A号B号 \/ A栋B栋 \/ 21号楼21-1号楼）\r\n  \/\/ 连续的判定：中间只允许少量空格\/分隔符\r\n  let runStart = matches[0].start;\r\n  let runEnd = matches[0].end;\r\n  const maxGap = 6; \/\/ 允许的间隔字符数（空格\/短分隔）\r\n  const gapOnlySeparatorRe = \/^[\\s\\-—_、\/\\\\.,，]+$\/;\r\n\r\n  for (let i = 1; i < matches.length; i++) {\r\n    const cur = matches[i];\r\n    const gapLen = cur.start - runEnd;\r\n    if (gapLen <= maxGap) {\r\n      const gap = head.slice(runEnd, cur.start);\r\n      \/\/ 如果 gap 里出现了中文\/字母\/数字\/括号，通常说明后面是“另一段描述”（如括号内重复门牌）\r\n      \/\/ 这种情况不要合并，否则会把 “马垅社22号（马拢社区22号...” 合并成一坨\r\n      if (\/[\\u4e00-\\u9fa5A-Za-z0-9]\/.test(gap)) break;\r\n      if (\/[()（）]\/.test(gap)) break;\r\n      if (gap && !gapOnlySeparatorRe.test(gap)) break;\r\n\r\n      runEnd = Math.max(runEnd, cur.end);\r\n      continue;\r\n    }\r\n    \/\/ 断开了就停止：只取最前面那一段连续门牌\/楼栋信息作为“核心”\r\n    break;\r\n  }\r\n\r\n  const core = head.slice(0, runEnd).trim();\r\n  if (!core || core.length < 2) return finalizeCore(s, false);\r\n  return finalizeCore(core, true);\r\n}\r\n\r\nfunction loadMerchantAliasConfig() {\r\n  \/\/ 依赖 node fs\/path（README 已说明支持）\r\n  try {\r\n    const fs = require('fs');\r\n    const path = require('path');\r\n    const dir = typeof __filename === 'string' ? path.dirname(__filename) : '';\r\n\r\n    const candidates = (Array.isArray(MERCHANT_ALIAS_CONFIG_PATHS) ? MERCHANT_ALIAS_CONFIG_PATHS : [])\r\n      .filter(Boolean)\r\n      .map(p => String(p))\r\n      .map(p => {\r\n        \/\/ 相对路径按脚本目录解析\r\n        if (!p.startsWith('\/') && dir) return path.join(dir, p);\r\n        return p;\r\n      });\r\n\r\n    const cfgPath = candidates.find(p => {\r\n      try {\r\n        return fs.existsSync(p);\r\n      } catch (_) {\r\n        return false;\r\n      }\r\n    });\r\n\r\n    if (!cfgPath) return { exact: {}, regex: [] };\r\n\r\n    const raw = fs.readFileSync(cfgPath) + '';\r\n    const json = JSON.parse(raw);\r\n\r\n    const exact = (json && typeof json.exact === 'object' && json.exact) || {};\r\n    const regexRules = Array.isArray(json?.regex) ? json.regex : [];\r\n    const timedRules = Array.isArray(json?.timed) ? json.timed : [];\r\n    const addressBlock = json && typeof json.address === 'object' ? json.address : null;\r\n    const addrExact = (addressBlock && typeof addressBlock.exact === 'object' && addressBlock.exact) || {};\r\n    const addrRegexRules = Array.isArray(addressBlock?.regex) ? addressBlock.regex : [];\r\n    const addrDisambiguateRules = Array.isArray(addressBlock?.disambiguate) ? addressBlock.disambiguate : [];\r\n\r\n    const compiled = [];\r\n    for (const r of regexRules) {\r\n      if (!r || typeof r !== 'object') continue;\r\n      if (typeof r.pattern !== 'string' || !r.pattern) continue;\r\n      const flags = typeof r.flags === 'string' ? r.flags : '';\r\n      const replace = typeof r.replace === 'string' ? r.replace : '';\r\n      try {\r\n        compiled.push({ re: new RegExp(r.pattern, flags), replace });\r\n      } catch (_) {\r\n        \/\/ ignore bad regex\r\n      }\r\n    }\r\n\r\n    const compiledAddr = [];\r\n    for (const r of addrRegexRules) {\r\n      if (!r || typeof r !== 'object') continue;\r\n      if (typeof r.pattern !== 'string' || !r.pattern) continue;\r\n      const flags = typeof r.flags === 'string' ? r.flags : '';\r\n      const replace = typeof r.replace === 'string' ? r.replace : '';\r\n      try {\r\n        compiledAddr.push({ re: new RegExp(r.pattern, flags), replace });\r\n      } catch (_) {\r\n        \/\/ ignore bad regex\r\n      }\r\n    }\r\n\r\n    const compiledAddrDisambiguate = [];\r\n    for (const r of addrDisambiguateRules) {\r\n      if (!r || typeof r !== 'object') continue;\r\n      const id = typeof r.id === 'string' && r.id.trim() ? r.id.trim() : '';\r\n      const mode = r.mode === 'regex' ? 'regex' : 'exact';\r\n      const match = typeof r.match === 'string' ? r.match : '';\r\n      const pattern = typeof r.pattern === 'string' ? r.pattern : '';\r\n      const flags = typeof r.flags === 'string' ? r.flags : '';\r\n      const title = typeof r.title === 'string' ? r.title : '';\r\n      const remember = !!r.remember;\r\n      const options = Array.isArray(r.options) ? r.options : [];\r\n\r\n      const compiledOptions = [];\r\n      for (const o of options) {\r\n        if (!o || typeof o !== 'object') continue;\r\n        const label = typeof o.label === 'string' ? o.label : '';\r\n        const replace = typeof o.replace === 'string' ? o.replace : '';\r\n        if (!replace) continue;\r\n        compiledOptions.push({ label: label || replace, replace });\r\n      }\r\n      if (!compiledOptions.length) continue;\r\n\r\n      let re = null;\r\n      if (mode === 'regex') {\r\n        if (!pattern) continue;\r\n        try {\r\n          re = new RegExp(pattern, flags);\r\n        } catch (_) {\r\n          continue;\r\n        }\r\n      } else {\r\n        if (!match) continue;\r\n      }\r\n      compiledAddrDisambiguate.push({ id, mode, match, re, title, remember, options: compiledOptions });\r\n    }\r\n\r\n    const compiledTimed = [];\r\n    for (const r of timedRules) {\r\n      if (!r || typeof r !== 'object') continue;\r\n      const mode = r.mode === 'regex' ? 'regex' : 'exact';\r\n      const match = typeof r.match === 'string' ? r.match : '';\r\n      const pattern = typeof r.pattern === 'string' ? r.pattern : '';\r\n      const flags = typeof r.flags === 'string' ? r.flags : '';\r\n      const start = typeof r.start === 'string' ? r.start : '';\r\n      const end = typeof r.end === 'string' ? r.end : '';\r\n      const replace = typeof r.replace === 'string' ? r.replace : '';\r\n      if (!replace || !start || !end) continue;\r\n      if (mode === 'exact' && !match) continue;\r\n      if (mode === 'regex' && !pattern) continue;\r\n\r\n      let re = null;\r\n      if (mode === 'regex') {\r\n        try {\r\n          re = new RegExp(pattern, flags);\r\n        } catch (_) {\r\n          continue;\r\n        }\r\n      }\r\n      compiledTimed.push({ mode, match, re, start, end, replace });\r\n    }\r\n\r\n    return {\r\n      exact,\r\n      regex: compiled,\r\n      timed: compiledTimed,\r\n      address: { exact: addrExact, regex: compiledAddr, disambiguate: compiledAddrDisambiguate }\r\n    };\r\n  } catch (e) {\r\n    \/\/ 读取失败不影响主流程\r\n    return { exact: {}, regex: [], timed: [], address: { exact: {}, regex: [], disambiguate: [] } };\r\n  }\r\n}\r\n\r\nconst MERCHANT_ALIAS = loadMerchantAliasConfig();\r\n\r\nfunction parseHHMM(s) {\r\n  const m = String(s || '').match(\/^(\\d{1,2}):(\\d{2})$\/);\r\n  if (!m) return null;\r\n  const hh = parseInt(m[1], 10);\r\n  const mm = parseInt(m[2], 10);\r\n  if (!(hh >= 0 && hh <= 23 && mm >= 0 && mm <= 59)) return null;\r\n  return hh * 60 + mm;\r\n}\r\n\r\nfunction isNowInTimeWindow(startHHMM, endHHMM, now = new Date()) {\r\n  const s = parseHHMM(startHHMM);\r\n  const e = parseHHMM(endHHMM);\r\n  if (s == null || e == null) return false;\r\n  const n = now.getHours() * 60 + now.getMinutes();\r\n  if (s === e) return true; \/\/ treat as always\r\n  if (s < e) return n >= s && n < e;\r\n  \/\/ across midnight\r\n  return n >= s || n < e;\r\n}\r\n\r\nfunction applyMerchantAlias(name) {\r\n  let n = normalizeText(name);\r\n  if (!n) return '';\r\n\r\n  \/\/ 过滤“抖音订单号\/店铺ID”一类的尾部长数字串：\r\n  \/\/ 例：DQ冰淇淋蛋糕店(厦门SM广场店)-7478261630171971611 -> DQ冰淇淋蛋糕店(厦门SM广场店)\r\n  \/\/ 只在末尾是“- + 纯数字且足够长”时触发，避免误伤正常门店名。\r\n  n = n.replace(\/[-—－]\\s*\\d{12,}\\s*$\/, '').trim();\r\n\r\n  \/\/ timed overrides (e.g. night closure)\r\n  for (const rule of MERCHANT_ALIAS?.timed || []) {\r\n    try {\r\n      if (!isNowInTimeWindow(rule.start, rule.end)) continue;\r\n      if (rule.mode === 'exact' && rule.match === n) return rule.replace;\r\n      if (rule.mode === 'regex' && rule.re && rule.re.test(n)) return n.replace(rule.re, rule.replace ?? '');\r\n    } catch (_) {\r\n      \/\/ ignore\r\n    }\r\n  }\r\n\r\n  if (MERCHANT_ALIAS?.exact && MERCHANT_ALIAS.exact[n]) return MERCHANT_ALIAS.exact[n];\r\n  for (const rule of MERCHANT_ALIAS?.regex || []) {\r\n    try {\r\n      if (rule?.re && rule.re.test(n)) return n.replace(rule.re, rule.replace ?? '');\r\n    } catch (_) {\r\n      \/\/ ignore bad rule\r\n    }\r\n  }\r\n  return n;\r\n}\r\n\r\nfunction applyCustomerAddressAlias(addr) {\r\n  const s = normalizeText(addr);\r\n  if (!s) return '';\r\n  const block = MERCHANT_ALIAS?.address;\r\n  if (block?.exact && block.exact[s]) return block.exact[s];\r\n  for (const rule of block?.regex || []) {\r\n    try {\r\n      if (rule?.re && rule.re.test(s)) return s.replace(rule.re, rule.replace ?? '');\r\n    } catch (_) {\r\n      \/\/ ignore\r\n    }\r\n  }\r\n  return s;\r\n}\r\n\r\nfunction getDisambiguationCacheKey(rule, matchedText) {\r\n  const id = rule?.id ? String(rule.id) : '';\r\n  const m = normalizeText(matchedText);\r\n  \/\/ matchedText 用于区分同一规则的不同命中（可选）；没有的话退化为 rule id\r\n  return `addr_disambiguate:${id || 'rule'}:${m || 'match'}`;\r\n}\r\n\r\nfunction getRememberedDisambiguation(rule, matchedText) {\r\n  if (!rule?.remember) return null;\r\n  const key = getDisambiguationCacheKey(rule, matchedText);\r\n  try {\r\n    \/\/ 优先用本地存储（跨脚本\/重启保留），scope 统一用 'global'\r\n    const v = zdjl.getStorage?.(key, 'global');\r\n    return typeof v === 'string' && v ? v : null;\r\n  } catch (_) {\r\n    \/\/ ignore\r\n  }\r\n  try {\r\n    const v = zdjl.getVar?.(key, 'global');\r\n    return typeof v === 'string' && v ? v : null;\r\n  } catch (_) {\r\n    \/\/ ignore\r\n  }\r\n  return null;\r\n}\r\n\r\nfunction rememberDisambiguation(rule, matchedText, replace) {\r\n  if (!rule?.remember) return;\r\n  const key = getDisambiguationCacheKey(rule, matchedText);\r\n  try {\r\n    zdjl.setStorage?.(key, String(replace || ''), 'global');\r\n    return;\r\n  } catch (_) {\r\n    \/\/ ignore\r\n  }\r\n  try {\r\n    zdjl.setVar?.(key, String(replace || ''), 'global');\r\n  } catch (_) {\r\n    \/\/ ignore\r\n  }\r\n}\r\n\r\nasync function applyCustomerAddressDisambiguation(addr) {\r\n  let s = normalizeText(addr);\r\n  if (!s) return '';\r\n\r\n  const rules = MERCHANT_ALIAS?.address?.disambiguate || [];\r\n  if (!Array.isArray(rules) || !rules.length) return s;\r\n\r\n  for (const rule of rules) {\r\n    try {\r\n      let matchedText = '';\r\n      if (rule.mode === 'regex' && rule.re) {\r\n        const m = s.match(rule.re);\r\n        if (!m) continue;\r\n        matchedText = m[0] || '';\r\n      } else {\r\n        const m = normalizeText(rule.match);\r\n        if (!m) continue;\r\n        if (!s.includes(m)) continue;\r\n        matchedText = m;\r\n      }\r\n\r\n      const remembered = getRememberedDisambiguation(rule, matchedText);\r\n      if (remembered) {\r\n        s = rule.mode === 'regex' && rule.re ? s.replace(rule.re, remembered) : s.replace(matchedText, remembered);\r\n        continue;\r\n      }\r\n\r\n      const options = Array.isArray(rule.options) ? rule.options : [];\r\n      if (!options.length) continue;\r\n\r\n      const items = options.map(o => String(o.label || o.replace || '')).filter(Boolean);\r\n      if (!items.length) continue;\r\n      items.push('跳过（不处理）');\r\n\r\n      const title =\r\n        normalizeText(rule.title) ||\r\n        `地址存在歧义：${normalizeText(matchedText) || s}\\n请选择要替换为：`;\r\n\r\n      let pickedIdx = -1;\r\n      try {\r\n        const sel = await zdjl.selectAsync?.({ title, items });\r\n        const { index, text } = parseSelectReturn(sel);\r\n        pickedIdx = Number.isFinite(index) ? index : typeof text === 'string' ? items.indexOf(text) : -1;\r\n      } catch (_) {\r\n        \/\/ fallback to sync select\r\n        try {\r\n          const sel = zdjl.select?.({ title, items });\r\n          const { index, text } = parseSelectReturn(sel);\r\n          pickedIdx = Number.isFinite(index) ? index : typeof text === 'string' ? items.indexOf(text) : -1;\r\n        } catch (__) {\r\n          pickedIdx = -1;\r\n        }\r\n      }\r\n\r\n      if (!(pickedIdx >= 0 && pickedIdx < items.length - 1)) continue; \/\/ skip \/ invalid\r\n      const picked = options[pickedIdx];\r\n      const rep = String(picked?.replace || '').trim();\r\n      if (!rep) continue;\r\n\r\n      s = rule.mode === 'regex' && rule.re ? s.replace(rule.re, rep) : s.replace(matchedText, rep);\r\n      rememberDisambiguation(rule, matchedText, rep);\r\n    } catch (_) {\r\n      \/\/ ignore single rule failure\r\n    }\r\n  }\r\n\r\n  return s;\r\n}\r\nfunction parseSelectReturn(sel) {\r\n  \/\/ README 描述：select 返回“选中索引和文字”\r\n  \/\/ 但不同版本可能返回 array \/ object \/ number \/ string，这里统一解析为 { index, text }\r\n  if (Array.isArray(sel)) {\r\n    const index = Number.isFinite(sel[0]) ? sel[0] : undefined;\r\n    const text = typeof sel[1] === 'string' ? sel[1] : undefined;\r\n    return { index, text };\r\n  }\r\n  if (typeof sel === 'number') return { index: sel, text: undefined };\r\n  if (typeof sel === 'string') return { index: undefined, text: sel };\r\n  if (sel && typeof sel === 'object') {\r\n    const index =\r\n      (Number.isFinite(sel.index) && sel.index) ||\r\n      (Number.isFinite(sel.selectedIndex) && sel.selectedIndex) ||\r\n      (Number.isFinite(sel.selected) && sel.selected) ||\r\n      (Number.isFinite(sel.i) && sel.i);\r\n\r\n    const text =\r\n      (typeof sel.text === 'string' && sel.text) ||\r\n      (typeof sel.selectedText === 'string' && sel.selectedText) ||\r\n      (typeof sel.value === 'string' && sel.value) ||\r\n      (typeof sel.item === 'string' && sel.item) ||\r\n      (typeof sel.label === 'string' && sel.label);\r\n\r\n    return { index, text };\r\n  }\r\n  return { index: undefined, text: undefined };\r\n}\r\n\r\nfunction getBounds(node) {\r\n  \/\/ 兼容不同字段命名\r\n  if (node && node.bounds && typeof node.bounds === 'object') {\r\n    const { l, t, r, b } = node.bounds;\r\n    if ([l, t, r, b].every(n => Number.isFinite(n))) return { l, t, r, b };\r\n  }\r\n  const l = node?.boundLeft ?? node?.boundsLeft ?? node?.left;\r\n  const t = node?.boundTop ?? node?.boundsTop ?? node?.top;\r\n  const r = node?.boundRight ?? node?.boundsRight ?? node?.right;\r\n  const b = node?.boundBottom ?? node?.boundsBottom ?? node?.bottom;\r\n  if ([l, t, r, b].every(n => Number.isFinite(n))) return { l, t, r, b };\r\n  return null;\r\n}\r\n\r\nfunction centerY(node) {\r\n  const b = getBounds(node);\r\n  return b ? (b.t + b.b) \/ 2 : Number.POSITIVE_INFINITY;\r\n}\r\n\r\nfunction centerX(node) {\r\n  const b = getBounds(node);\r\n  return b ? (b.l + b.r) \/ 2 : Number.POSITIVE_INFINITY;\r\n}\r\n\r\nfunction traverse(node, out) {\r\n  if (!node) return;\r\n  out.push(node);\r\n  const children = node.children || node.childNodes || node.child || node.nodes || [];\r\n  if (Array.isArray(children)) {\r\n    for (const c of children) traverse(c, out);\r\n  }\r\n}\r\n\r\nfunction safeFindAllTextViews() {\r\n  try {\r\n    const res = zdjl.findNode(\r\n      { type: 'node', className: 'android.widget.TextView' },\r\n      { findAll: true }\r\n    );\r\n    if (Array.isArray(res)) return res;\r\n    if (res && Array.isArray(res.nodes)) return res.nodes;\r\n  } catch (_) {\r\n    \/\/ ignore\r\n  }\r\n\r\n  \/\/ fallback：从内容根节点递归抓取\r\n  const root =\r\n    zdjl.findNode({ type: 'node', idResName: 'android:id\/content' }, { withChildren: true }) ||\r\n    zdjl.findNode({ type: 'node', idResName: 'me.ele.crowdsource:id\/home_layout' }, { withChildren: true });\r\n\r\n  const all = [];\r\n  traverse(root, all);\r\n  return all.filter(n => n && n.className === 'android.widget.TextView');\r\n}\r\n\r\nfunction isDistanceText(t) {\r\n  \/\/ 兼容多种展示（尽量保守，避免把地址误判为距离）：\r\n  \/\/ - \"2.1\\nkm\" \/ \"840\\nm\"\r\n  \/\/ - \"2.1km\" \/ \"840m\"\r\n  \/\/ - \"距取3.5km\" \/ \"距送800m\"\r\n  const s = normalizeText(t);\r\n  if (!s) return false;\r\n\r\n  \/\/ 单独单位（有些 UI 会把数字和单位拆成两个 TextView）\r\n  if (\/^(km|m)$\/i.test(s)) return true;\r\n\r\n  \/\/ 距离数字 + 单位（可带“距取\/距送”，可换行）\r\n  \/\/ 这里要求整段文本“像一个距离”，避免误伤“xx路xx号xxxkm外”这种句子\r\n  const distanceLineRe = \/^(?:距取|距送)?\\s*\\d+(?:\\.\\d+)?\\s*(?:km|m)$\/i;\r\n  const distanceTwoLineRe = \/^(?:距取|距送)?\\s*\\d+(?:\\.\\d+)?\\s*\\n\\s*(?:km|m)$\/i;\r\n  if (distanceLineRe.test(s)) return true;\r\n  if (distanceTwoLineRe.test(s)) return true;\r\n\r\n  return false;\r\n}\r\n\r\nfunction isEtaText(t) {\r\n  \/\/ 例如 \"31分钟内(18:49前)送达\"\r\n  return \/分钟\/.test(t) || \/送达\/.test(t);\r\n}\r\n\r\nfunction isStatusOrHintText(t) {\r\n  \/\/ 屏蔽“商户已出货”等无关状态提示，避免被误当作地址\r\n  if (!t) return false;\r\n  const s = normalizeText(t);\r\n\r\n  \/\/ 按钮\/操作文案（在详情页里很常见，避免被误识别为店名\/地址）\r\n  if (\/^(复制|抢单|接单|取消|关闭|确认|确定)$\/.test(s)) return true;\r\n  if (\/(确认送达|刷新订单)\/.test(s)) return true;\r\n  if (\/导航\/.test(s)) return true;\r\n\r\n  \/\/ 常见状态\/流程提示（按需继续补充）\r\n  if (\/已出货\/.test(s)) return true;\r\n  if (\/已取货|已到店|已到达|已送达\/.test(s)) return true;\r\n  if (\/商户|商家|门店\/.test(s) && \/(已|正在|开始|等待).*(出货|接单|备货|打包|配货|制作|出餐)\/.test(s)) return true;\r\n\r\n  \/\/ 类似“无需联系\/联系商家\/到店联系”等提示也通常不是地址\r\n  if (\/(无需联系|联系商家|联系顾客|联系骑手|到店联系|到店取货)\/.test(s)) return true;\r\n\r\n  return false;\r\n}\r\n\r\nfunction isCustomerRemarkText(t) {\r\n  \/\/ 详情页里常见“顾客备注\/备注\/餐具”等，不应当被当成顾客地址\r\n  if (!t) return false;\r\n  const s = normalizeText(t);\r\n  if (\/^顾客备注[:：]\/.test(s)) return true;\r\n  if (\/^备注[:：]\/.test(s)) return true;\r\n  \/\/ 待送达列表可能出现“收货人与下单人不一致”等提示（无冒号）\r\n  if (\/^收货人\/.test(s)) return true;\r\n  if (\/下单人\/.test(s) && \/不一致\/.test(s)) return true;\r\n  if (\/餐具|餐量|口味|忌口|少辣|多辣|少冰|多冰|加冰|不辣\/.test(s)) return true;\r\n  return false;\r\n}\r\n\r\nfunction isNoiseTagText(t) {\r\n  \/\/ 订单标签（可能出现更多，按需加）\r\n  \/\/ 待送达列表里会出现“积分奖”等徽标\r\n  if (t === '积分奖' || t === '积分') return true;\r\n  return t === '优送' || t === '专送' || t === '帮买' || t === '帮送' || isStatusOrHintText(t);\r\n}\r\n\r\nfunction isIgnorableTextForExtraction(t) {\r\n  \/\/ 提取店名\/地址时需要排除的文本类型（但距离用于另一种分组算法，所以不在这里排除）\r\n  return isEtaText(t) || isNoiseTagText(t) || isStatusOrHintText(t) || isCustomerRemarkText(t);\r\n}\r\n\r\nfunction isLikelyAddress(t) {\r\n  \/\/ 地址\/楼宇\/小区\/门牌等关键词；尽量过滤掉纯标题类文本\r\n  if (!t) return false;\r\n  if (isDistanceText(t) || isIgnorableTextForExtraction(t)) return false;\r\n  if (t.length < 4) return false;\r\n\r\n  \/\/ 先排除“明显像店名\/POI 名称”的文本，避免把“东浦路店\/XX路店”误判为地址\r\n  \/\/ 例：华莱士·全鸡汉堡(时尚国际东浦路店) —— 含“路”但实际上是店名\r\n  const looksLikeStore =\r\n    \/[（(].{0,30}(店|分店)[)）]$\/.test(t) || \/(店|分店)$\/.test(t) || \/·\/.test(t);\r\n  \/\/ 这里不要把“店名里的数字\/路名”当成地址强特征（很多门店名会带路名\/门店编号）\r\n  \/\/ 只有出现明显的楼栋\/门牌\/房间等标记，才认为可能是地址\r\n  const hasStrongAddressMarkers =\r\n    \/[号號]|[栋棟]|[楼樓]|(单元|單元)|室|层|層|座|梯|小区|小區|大厦|大廈|公寓|写字楼|寫字樓\/.test(t);\r\n  if (looksLikeStore && !hasStrongAddressMarkers) return false;\r\n\r\n  \/\/ 常见地址特征：包含道路\/门牌\/楼层\/房间\/建筑\/小区等\r\n  \/\/ 兼容繁体：號\/樓\/層\/棟\/單元\r\n  const kw =\r\n    \/(路|街|道|巷|弄|号|號|室|楼|樓|层|層|座|栋|棟|单元|單元|小区|大厦|中心|广场|花园|公寓|写字楼|酒店|苑|园|村|镇|区)\/;\r\n  if (kw.test(t)) return true;\r\n\r\n  \/\/ 兜底：含有数字 + 中文（例如“10层***”一类）\r\n  if (\/\\d\/.test(t) && \/[\\u4e00-\\u9fa5]\/.test(t) && t.length >= 6) return true;\r\n\r\n  return false;\r\n}\r\n\r\nfunction isLikelyMerchantName(t) {\r\n  if (!t) return false;\r\n  if (isDistanceText(t) || isIgnorableTextForExtraction(t)) return false;\r\n  if (t.length < 2 || t.length > 40) return false;\r\n  if (!\/[\\u4e00-\\u9fa5]\/.test(t)) return false;\r\n  if (isLikelyAddress(t)) return false;\r\n\r\n  \/\/ 餐饮\/门店名常见特征：包含“店”或括号分店信息\r\n  if (\/[（(].+[)）]\/.test(t)) return true;\r\n  if (\/店\/.test(t)) return true;\r\n  \/\/ 饮品类\/小吃类关键词（补充：奶茶\/茶饮\/饮品\/冰淇淋 等）\r\n  if (\/(餐|饭|面|粉|汤|粥|茶|茶饮|奶茶|饮品|咖啡|甜品|冰淇淋|炸鸡|烧烤|超市|便利|药店|生鲜)\/.test(t))\r\n    return true;\r\n\r\n  \/\/ 兜底：长度适中且不是明显功能词\r\n  if (!\/(返回|更多|确定|取消|设置|路线|导航)\/.test(t) && t.length <= 20) return true;\r\n  return false;\r\n}\r\n\r\nfunction buildOrderRecords(textNodes) {\r\n  \/\/ 用“店名下面必须跟着能识别成地址的 TextView”来判定一单，能覆盖短店名（如 1点点\/蜜雪冰城）\r\n  const merchantCandidates = textNodes\r\n    .map(n => ({ n, t: normalizeText(n.text), b: getBounds(n) }))\r\n    .filter(x => x.b && x.t)\r\n    \/\/ 店名候选：用 isLikelyMerchantName 做初筛；再兜底允许“短文本+含中文+不是地址”\r\n    .filter(x => {\r\n      if (isLikelyMerchantName(x.t)) return true;\r\n      if (x.t.length >= 2 && x.t.length <= 10 && \/[\\u4e00-\\u9fa5]\/.test(x.t) && !isLikelyAddress(x.t)) return true;\r\n      return false;\r\n    })\r\n    .sort((a, b) => a.b.t - b.b.t || a.b.l - b.b.l);\r\n\r\n  const orders = [];\r\n  for (const m of merchantCandidates) {\r\n    const info = extractOrderInfoFromMerchantNode(m.n, textNodes);\r\n    if (!info) continue;\r\n    \/\/ 详情页\/特殊卡片里可能只有一侧地址先渲染出来，这里放宽条件\r\n    if (!info.merchantDetailAddress && !info.customerAddress) continue;\r\n    orders.push({\r\n      merchantNode: m.n,\r\n      merchantBounds: m.b,\r\n      ...info\r\n    });\r\n  }\r\n\r\n  \/\/ 去重：同一单可能在控件树里出现多次相邻节点（或重复渲染）\r\n  const deduped = [];\r\n  const minDy = 60;\r\n  for (const o of orders) {\r\n    const last = deduped[deduped.length - 1];\r\n    if (!last) {\r\n      deduped.push(o);\r\n      continue;\r\n    }\r\n    if (Math.abs(o.merchantBounds.t - last.merchantBounds.t) <= minDy && o.merchantName === last.merchantName) {\r\n      continue;\r\n    }\r\n    deduped.push(o);\r\n  }\r\n  return deduped;\r\n}\r\n\r\nfunction extractOrderInfoFromMerchantNode(merchantNode, textNodes) {\r\n  const merchantName = normalizeText(merchantNode.text);\r\n  const mb = getBounds(merchantNode);\r\n  if (!mb) return null;\r\n\r\n  \/\/ 地址行在不同机型上常见有缩进（比店名更靠右），这里放宽同列阈值\r\n  const sameColumnThresholdPx = 150;\r\n  const maxSearchHeightPx = 900;\r\n\r\n  const candidates = textNodes\r\n    .map(n => ({ n, t: normalizeText(n.text), b: getBounds(n) }))\r\n    .filter(x => x.b && x.t)\r\n    .filter(x => x.b.t > mb.t && x.b.t - mb.t <= maxSearchHeightPx)\r\n    .filter(x => Math.abs(x.b.l - mb.l) <= sameColumnThresholdPx)\r\n    .sort((a, b) => a.b.t - b.b.t || a.b.l - b.b.l);\r\n\r\n  \/\/ 先按“像地址”提取；不够时按“顺序兜底”\r\n  \/\/ 注意：顾客地址在详情页可能是 POI 名称（例如“超鹿运动卧龙晓城店”），不一定包含“路\/号\/楼”等关键字\r\n  \/\/ 同时要屏蔽“顾客备注：...”这类文本，避免误识别为顾客地址\r\n  const nonIgnorable = candidates\r\n    .filter(x => !isDistanceText(x.t))\r\n    .filter(x => !isIgnorableTextForExtraction(x.t))\r\n    .filter(x => x.t !== merchantName);\r\n\r\n  const addressCandidates = nonIgnorable.filter(x => isLikelyAddress(x.t));\r\n  \/\/ 取货地址：优先“像地址”的第一条；不行再取下方第一条非店名文本（避免把距离\/状态当地址）\r\n  const merchantDetailAddress =\r\n    (addressCandidates[0] ||\r\n      nonIgnorable.find(x => x.t && !isLikelyMerchantName(x.t) && x.t.length >= 4) ||\r\n      nonIgnorable[0])?.t || '';\r\n  const customerAddress =\r\n    (addressCandidates[1] ||\r\n      nonIgnorable.find(x => x.t && x.t !== merchantDetailAddress) ||\r\n      null)?.t || '';\r\n\r\n  if (DEBUG_DUMP_CANDIDATES) {\r\n    console.log('[debug] merchant:', merchantName, 'bounds:', mb);\r\n    console.log(\r\n      '[debug] near-by candidates:',\r\n      candidates.slice(0, 12).map(x => ({ text: x.t, b: x.b }))\r\n    );\r\n    console.log(\r\n      '[debug] address candidates:',\r\n      addressCandidates.slice(0, 6).map(x => ({ text: x.t, b: x.b }))\r\n    );\r\n  }\r\n\r\n  return {\r\n    merchantName,\r\n    merchantDetailAddress,\r\n    customerAddress\r\n  };\r\n}\r\n\r\nfunction buildOrderRecordsByDistancePairs(allTextNodes) {\r\n  \/\/ 利用 UI 结构的“距离-右侧文本”对齐规律来提取（对店名\/地址关键词不敏感）\r\n  \/\/ 每张卡片通常有两行距离：取货距离 + 送达距离，对应右侧：商家名 + 顾客地址\r\n  const nodes = allTextNodes\r\n    .map(n => ({ n, t: normalizeText(n.text), b: getBounds(n) }))\r\n    .filter(x => x.b && x.t)\r\n    .sort((a, b) => a.b.t - b.b.t || a.b.l - b.b.l);\r\n\r\n  const distanceNodes = nodes.filter(x => isDistanceText(x.t));\r\n  if (distanceNodes.length < 2) return [];\r\n\r\n  function pickRightAlignedText(anchor, maxDy) {\r\n    const ab = anchor.b;\r\n    const cand = nodes\r\n      .filter(x => x.b.l >= ab.r - 5) \/\/ 紧贴距离右侧\r\n      .filter(x => Math.abs(x.b.t - ab.t) <= maxDy)\r\n      .filter(x => !isDistanceText(x.t))\r\n      .filter(x => !isIgnorableTextForExtraction(x.t))\r\n      .sort((a, b) => a.b.l - b.b.l);\r\n    return cand[0] || null;\r\n  }\r\n\r\n  function pickFirstBelowInRightColumn(topY, bottomY, minLeft) {\r\n    const cand = nodes\r\n      .filter(x => x.b.l >= minLeft)\r\n      .filter(x => x.b.t > topY && x.b.t < bottomY)\r\n      .filter(x => !isDistanceText(x.t))\r\n      .filter(x => !isIgnorableTextForExtraction(x.t))\r\n      .sort((a, b) => a.b.t - b.b.t || a.b.l - b.b.l);\r\n    return cand[0] || null;\r\n  }\r\n\r\n  function pickPickupAddressBelowMerchant(merchantNode, bottomY) {\r\n    if (!merchantNode?.b) return null;\r\n    const mb = merchantNode.b;\r\n\r\n    \/\/ 优先：商家名下方、同一列附近、且“像地址”的第一条\r\n    const preferred = nodes\r\n      .filter(x => x.b.t > mb.b - 2 && x.b.t < bottomY)\r\n      .filter(x => !isDistanceText(x.t))\r\n      .filter(x => !isIgnorableTextForExtraction(x.t))\r\n      \/\/ 允许一定的缩进差异（UI 常见：地址比店名更靠右）\r\n      .filter(x => x.b.l >= mb.l - 40 && x.b.l <= mb.l + 220)\r\n      .sort((a, b) => a.b.t - b.b.t || a.b.l - b.b.l);\r\n\r\n    const addr = preferred.find(x => isLikelyAddress(x.t));\r\n    if (addr) return addr;\r\n\r\n    \/\/ 兜底：找不到明显地址时，取商家名下方第一条“非店名\/非状态”的较长文本\r\n    const fallback = preferred.find(x => x.t.length >= 4 && !isLikelyMerchantName(x.t));\r\n    return fallback || null;\r\n  }\r\n\r\n  const orders = [];\r\n  for (let i = 0; i < distanceNodes.length - 1; i++) {\r\n    const d1 = distanceNodes[i];\r\n    const d2 = distanceNodes[i + 1];\r\n\r\n    const dy = d2.b.t - d1.b.t;\r\n    if (!(dy > 60 && dy < 350)) continue;\r\n\r\n    const merchantNode = pickRightAlignedText(d1, 45);\r\n    const customerNode = pickRightAlignedText(d2, 45);\r\n    const pickupAddrNode = merchantNode\r\n      ? pickFirstBelowInRightColumn(merchantNode.b.t, d2.b.t, Math.max(120, merchantNode.b.l - 30)) ||\r\n        pickPickupAddressBelowMerchant(merchantNode, d2.b.t)\r\n      : null;\r\n\r\n    const merchantName = merchantNode?.t || '';\r\n    const merchantDetailAddress = pickupAddrNode?.t || '';\r\n    const customerAddress = customerNode?.t || '';\r\n\r\n    if (!merchantName) continue;\r\n    if (!merchantDetailAddress && !customerAddress) continue;\r\n\r\n    orders.push({\r\n      merchantName,\r\n      merchantDetailAddress,\r\n      customerAddress,\r\n      merchantBounds: merchantNode?.b || d1.b\r\n    });\r\n\r\n    \/\/ 跳过配对的第二个距离，避免同卡片重复\r\n    i++;\r\n  }\r\n\r\n  \/\/ 去重\r\n  const deduped = [];\r\n  const minDy = 60;\r\n  for (const o of orders) {\r\n    const last = deduped[deduped.length - 1];\r\n    if (!last) {\r\n      deduped.push(o);\r\n      continue;\r\n    }\r\n    if (Math.abs(o.merchantBounds.t - last.merchantBounds.t) <= minDy && o.merchantName === last.merchantName) continue;\r\n    deduped.push(o);\r\n  }\r\n  return deduped;\r\n}\r\n\r\nfunction buildOrderRecordsBySingleDistance(allTextNodes) {\r\n  \/\/ “待送达\/配送中”分区常见结构：只有一个“距离”，右侧同一行是顾客地址；商家名在上方\r\n  const nodes = allTextNodes\r\n    .map(n => ({ n, t: normalizeText(n.text), b: getBounds(n) }))\r\n    .filter(x => x.b && x.t)\r\n    .sort((a, b) => a.b.t - b.b.t || a.b.l - b.b.l);\r\n\r\n  const distanceNodes = nodes.filter(x => isDistanceText(x.t));\r\n  if (!distanceNodes.length) return [];\r\n\r\n  function pickRightAlignedText(anchor, maxDy) {\r\n    const ab = anchor.b;\r\n    const cand = nodes\r\n      .filter(x => x.b.l >= ab.r - 5)\r\n      .filter(x => Math.abs(x.b.t - ab.t) <= maxDy)\r\n      .filter(x => !isDistanceText(x.t))\r\n      .filter(x => !isIgnorableTextForExtraction(x.t))\r\n      .sort((a, b) => a.b.l - b.b.l);\r\n    return cand[0] || null;\r\n  }\r\n\r\n  function pickNearestMerchantAbove(yTop, minLeft) {\r\n    const cand = nodes\r\n      .filter(x => x.b.l >= minLeft)\r\n      .filter(x => x.b.b <= yTop + 5)\r\n      .filter(x => yTop - x.b.b <= 260)\r\n      .filter(x => !isIgnorableTextForExtraction(x.t))\r\n      .filter(x => !isDistanceText(x.t))\r\n      \/\/ 待送达列表的“商家名”很像店名：优先用店名规则筛选，避免被地址规则误伤\r\n      .filter(x => isLikelyMerchantName(x.t))\r\n      .sort((a, b) => (yTop - a.b.b) - (yTop - b.b.b));\r\n    return cand[0] || null;\r\n  }\r\n\r\n  const orders = [];\r\n  for (const d of distanceNodes) {\r\n    const customerNode = pickRightAlignedText(d, 55);\r\n    if (!customerNode) continue;\r\n\r\n    const merchantNode = pickNearestMerchantAbove(d.b.t, Math.max(150, customerNode.b.l - 10));\r\n    const merchantName = merchantNode?.t || '';\r\n    const customerAddress = customerNode.t || '';\r\n\r\n    if (!merchantName || !customerAddress) continue;\r\n\r\n    orders.push({\r\n      merchantName,\r\n      merchantDetailAddress: '', \/\/ 待送达列表通常不展示取货地址\r\n      customerAddress,\r\n      merchantBounds: merchantNode?.b || d.b\r\n    });\r\n  }\r\n\r\n  \/\/ 去重\r\n  const deduped = [];\r\n  const minDy = 60;\r\n  for (const o of orders) {\r\n    const last = deduped[deduped.length - 1];\r\n    if (!last) {\r\n      deduped.push(o);\r\n      continue;\r\n    }\r\n    if (Math.abs(o.merchantBounds.t - last.merchantBounds.t) <= minDy && o.merchantName === last.merchantName) continue;\r\n    deduped.push(o);\r\n  }\r\n  return deduped;\r\n}\r\n\r\nfunction buildOrderRecordsByConfirmDelivery(allTextNodes) {\r\n  \/\/ 待送达\/配送中卡片常见结构：每张卡片都有“确认送达”按钮\r\n  \/\/ 用按钮作为卡片锚点向上回溯，提取商家名与顾客地址，避免依赖距离字段\r\n  const nodes = allTextNodes\r\n    .map(n => ({ n, t: normalizeText(n.text), b: getBounds(n) }))\r\n    .filter(x => x.b && x.t)\r\n    .sort((a, b) => a.b.t - b.b.t || a.b.l - b.b.l);\r\n\r\n  const confirmNodes = nodes.filter(x => x.t === '确认送达');\r\n  if (!confirmNodes.length) return [];\r\n\r\n  const orders = [];\r\n  for (const c of confirmNodes) {\r\n    const top = Math.max(0, c.b.t - 950);\r\n    const bottom = c.b.b + 10;\r\n    const inCard = nodes\r\n      .filter(x => x.b.t >= top && x.b.b <= bottom)\r\n      .filter(x => !isIgnorableTextForExtraction(x.t))\r\n      .filter(x => x.t !== '确认送达')\r\n      .sort((a, b) => a.b.t - b.b.t || a.b.l - b.b.l);\r\n\r\n    const merchant = inCard.find(x => isLikelyMerchantName(x.t));\r\n    if (!merchant) continue;\r\n\r\n    \/\/ 顾客地址：优先像地址\/POI，其次取商家名下方第一个较长文本\r\n    const afterMerchant = inCard.filter(x => x.b.t >= merchant.b.b - 2);\r\n    const customer =\r\n      afterMerchant.find(x => isLikelyAddress(x.t) || isKeyDeliveryPoi(x.t)) ||\r\n      afterMerchant.find(x => x.t.length >= 4 && !isLikelyMerchantName(x.t));\r\n\r\n    if (!customer) continue;\r\n\r\n    orders.push({\r\n      merchantName: merchant.t,\r\n      merchantDetailAddress: '',\r\n      customerAddress: customer.t,\r\n      merchantBounds: merchant.b\r\n    });\r\n  }\r\n\r\n  \/\/ 去重（同屏重复渲染）\r\n  const deduped = [];\r\n  const minDy = 60;\r\n  for (const o of orders) {\r\n    const last = deduped[deduped.length - 1];\r\n    if (!last) {\r\n      deduped.push(o);\r\n      continue;\r\n    }\r\n    if (Math.abs(o.merchantBounds.t - last.merchantBounds.t) <= minDy && o.merchantName === last.merchantName) continue;\r\n    deduped.push(o);\r\n  }\r\n  return deduped;\r\n}\r\n\r\nasync function main() {\r\n  if (AUTO_SHOW_CONSOLE) console.show();\r\n  console.log('开始获取控件中的商家\/地址信息...');\r\n  console.log('[script-build]', '92a8e12');\r\n\r\n  \/\/ 给页面一点时间稳定（如果你是在点击进入页面后立刻运行）\r\n  await zdjl.sleepAsync?.(300);\r\n\r\n  const textViews = safeFindAllTextViews();\r\n  const allTextNodes = (Array.isArray(textViews) ? textViews : [])\r\n    .filter(n => n && typeof n === 'object')\r\n    .filter(n => normalizeText(n.text))\r\n    .filter(n => getBounds(n))\r\n    .sort((a, b) => centerY(a) - centerY(b) || centerX(a) - centerX(b));\r\n\r\n  if (!allTextNodes.length) {\r\n    zdjl.toast('没找到 TextView 文本节点，检查是否在目标页面');\r\n    console.error('未找到可用文本节点');\r\n    return;\r\n  }\r\n\r\n  const pendingCtx = isPendingDeliveryContext(allTextNodes);\r\n\r\n  \/\/ 优先使用“距离成对”推断订单（更贴近订单卡片结构，适配各种店名\/地址文案）\r\n  const ordersByDistance = buildOrderRecordsByDistancePairs(allTextNodes);\r\n  const ordersBySingleDistance =\r\n    ordersByDistance.length === 0 ? buildOrderRecordsBySingleDistance(allTextNodes) : [];\r\n  const ordersByConfirm =\r\n    pendingCtx && ordersByDistance.length === 0 && ordersBySingleDistance.length === 0\r\n      ? buildOrderRecordsByConfirmDelivery(allTextNodes)\r\n      : [];\r\n  const cleanedTextNodes = allTextNodes.filter(n => {\r\n    const t = normalizeText(n.text);\r\n    return !(isDistanceText(t) || isIgnorableTextForExtraction(t));\r\n  });\r\n  const orders = ordersByDistance.length\r\n    ? ordersByDistance\r\n    : ordersBySingleDistance.length\r\n      ? ordersBySingleDistance\r\n      : ordersByConfirm.length\r\n        ? ordersByConfirm\r\n      : buildOrderRecords(cleanedTextNodes);\r\n  if (!orders.length) {\r\n    zdjl.toast('没找到订单卡片（店名\/地址匹配失败）');\r\n    console.error('未找到订单卡片');\r\n    return;\r\n  }\r\n\r\n  let selectedIdx = Math.max(0, Math.min(ORDER_INDEX, orders.length - 1));\r\n  if (SHOW_ORDER_PICKER && (orders.length > 1 || pendingCtx)) {\r\n    \/\/ 待送达页面优先弹一次选择，方便提前复制下一单\r\n    selectedIdx = await pickOrderIndexInteractive(orders);\r\n  }\r\n\r\n  while (true) {\r\n    const order = orders[selectedIdx];\r\n    if (!order) {\r\n      zdjl.toast(`选择的订单不存在（共${orders.length}单）`);\r\n      console.error('订单索引越界');\r\n      return;\r\n    }\r\n\r\n    const customerAddr = extractAddressCore(order.customerAddress);\r\n    const customerAddrAliased = applyCustomerAddressAlias(\r\n      trimCompanyFloorParen(normalizeCnBuildingNumbers(customerAddr.core))\r\n    );\r\n    const customerAddrFinal = await applyCustomerAddressDisambiguation(customerAddrAliased);\r\n    const result = {\r\n      merchantName: applyMerchantAlias(order.merchantName),\r\n      merchantDetailAddress: trimCompanyFloorParen(normalizeHaoZhi(order.merchantDetailAddress)),\r\n      customerAddress: customerAddrFinal,\r\n      customerAddressMatched: customerAddr.matched\r\n    };\r\n\r\n    console.log('提取结果：', JSON.stringify(result, null, 2));\r\n    if (SHOW_RESULT_ALERT) {\r\n      try {\r\n        await zdjl.alertAsync(\r\n          `商家名称：\\n${result.merchantName || ''}\\n\\n取货地址：\\n${result.merchantDetailAddress || ''}\\n\\n顾客地址：\\n${result.customerAddress || ''}`,\r\n          { title: '提取结果', duration: 5000 }\r\n        );\r\n      } catch (_) {\r\n        \/\/ fallback：不支持 alertAsync 的版本\r\n        try {\r\n          zdjl.alert(\r\n            `商家名称：\\n${result.merchantName || ''}\\n\\n取货地址：\\n${result.merchantDetailAddress || ''}\\n\\n顾客地址：\\n${result.customerAddress || ''}`,\r\n            { title: '提取结果', duration: 5000 }\r\n          );\r\n        } catch (__) {\r\n          \/\/ ignore\r\n        }\r\n      }\r\n    } else {\r\n      zdjl.toast(\r\n        `商家：${result.merchantName}\\n取货：${result.merchantDetailAddress}\\n顾客：${result.customerAddress}`,\r\n        5000\r\n      );\r\n    }\r\n\r\n    const clip = `${result.merchantName}\\n${result.merchantDetailAddress}\\n${result.customerAddress}`.trim();\r\n\r\n    if (COPY_TO_CLIPBOARD) {\r\n      zdjl.setClipboard(clip);\r\n      console.log('已自动复制到剪贴板：\\n' + clip);\r\n    }\r\n\r\n    \/\/ “点击复制”按钮：用选择弹窗承载（无需悬浮窗权限）\r\n    if (SHOW_COPY_BUTTON) {\r\n      try {\r\n        const mPreview = shortenForMenu(result.merchantName);\r\n        const pPreview = shortenForMenu(result.merchantDetailAddress);\r\n        const cPreview = shortenForMenu(result.customerAddress);\r\n\r\n        \/\/ 创建二级弹窗函数（内容和第一个弹窗一样）\r\n        const showSecondaryMenu = async () => {\r\n          const secondaryMenuItems = [\r\n            `复制商家名称：${mPreview || '(空)'}`,\r\n            `复制取货地址：${pPreview || '(空)'}`,\r\n            `复制顾客地址：${cPreview || '(空)'}${result.customerAddressMatched ? '' : '（未裁剪）'}`\r\n          ];\r\n\r\n          const secondarySwitchOrderLabel = '切换订单…';\r\n          const secondaryHasSwitch = SHOW_ORDER_PICKER && orders.length > 1;\r\n          if (secondaryHasSwitch) secondaryMenuItems.push(secondarySwitchOrderLabel);\r\n          secondaryMenuItems.push('关闭');\r\n\r\n          const secondarySelectTitle = result.customerAddressMatched\r\n            ? `选择要复制的内容（第${selectedIdx + 1}\/${orders.length}单）`\r\n            : `顾客地址未裁剪（将显示原文本）：\\n${result.customerAddress || ''}\\n\\n选择要复制的内容（第${selectedIdx + 1}\/${orders.length}单）`;\r\n\r\n          while (true) {\r\n            const sel = await zdjl.selectAsync({\r\n              title: secondarySelectTitle,\r\n              items: secondaryMenuItems\r\n            });\r\n            const { index, text } = parseSelectReturn(sel);\r\n\r\n            \/\/ 兼容只返回 text 的情况\r\n            const picked =\r\n              Number.isFinite(index) ? index : typeof text === 'string' ? secondaryMenuItems.indexOf(text) : -1;\r\n\r\n            if (picked === 0) {\r\n              const content = `[UNMATCH]${result.merchantName || ''}`;\r\n              zdjl.setClipboard(content);\r\n              zdjl.toast('已复制：商家名称（带[UNMATCH]前缀）');\r\n              console.log('已手动复制：商家名称（带[UNMATCH]前缀）\\n' + content);\r\n              continue;\r\n            }\r\n            if (picked === 1) {\r\n              const content = `[UNMATCH]${result.merchantDetailAddress || ''}`;\r\n              zdjl.setClipboard(content);\r\n              zdjl.toast('已复制：取货地址（带[UNMATCH]前缀）');\r\n              console.log('已手动复制：取货地址（带[UNMATCH]前缀）\\n' + content);\r\n              continue;\r\n            }\r\n            if (picked === 2) {\r\n              const content = `[UNMATCH]${result.customerAddress || ''}`;\r\n              zdjl.setClipboard(content);\r\n              zdjl.toast('已复制：顾客地址（带[UNMATCH]前缀）');\r\n              console.log('已手动复制：顾客地址（带[UNMATCH]前缀）\\n' + content);\r\n              continue;\r\n            }\r\n\r\n            if (secondaryHasSwitch && picked === 3) {\r\n              \/\/ 切换订单：退出复制菜单，回到外层循环重新生成 result\r\n              selectedIdx = await pickOrderIndexInteractive(orders);\r\n              return 'switch'; \/\/ 返回特殊标记，表示需要切换订单\r\n            }\r\n\r\n            \/\/ 关闭\/未选中\/未知返回 - 直接关闭所有弹窗\r\n            return 'close';\r\n          }\r\n        };\r\n\r\n        const menuItems = [\r\n          '[UNMATCH]',\r\n          `复制商家名称：${mPreview || '(空)'}`,\r\n          `复制取货地址：${pPreview || '(空)'}`,\r\n          `复制顾客地址：${cPreview || '(空)'}${result.customerAddressMatched ? '' : '（未裁剪）'}`\r\n        ];\r\n\r\n        const switchOrderLabel = '切换订单…';\r\n        const hasSwitch = SHOW_ORDER_PICKER && orders.length > 1;\r\n        if (hasSwitch) menuItems.push(switchOrderLabel);\r\n        menuItems.push('关闭');\r\n\r\n        const selectTitle = result.customerAddressMatched\r\n          ? `选择要复制的内容（第${selectedIdx + 1}\/${orders.length}单）`\r\n          : `顾客地址未裁剪（将显示原文本）：\\n${result.customerAddress || ''}\\n\\n选择要复制的内容（第${selectedIdx + 1}\/${orders.length}单）`;\r\n\r\n        while (true) {\r\n          const sel = await zdjl.selectAsync({\r\n            title: selectTitle,\r\n            items: menuItems\r\n          });\r\n          const { index, text } = parseSelectReturn(sel);\r\n\r\n          \/\/ 兼容只返回 text 的情况\r\n          const picked =\r\n            Number.isFinite(index) ? index : typeof text === 'string' ? menuItems.indexOf(text) : -1;\r\n\r\n          if (picked === 0) {\r\n            \/\/ [UNMATCH] 选项：弹出二级弹窗\r\n            const secondaryResult = await showSecondaryMenu();\r\n            if (secondaryResult === 'switch') {\r\n              \/\/ 需要切换订单，退出当前循环\r\n              selectedIdx = await pickOrderIndexInteractive(orders);\r\n              break;\r\n            }\r\n            if (secondaryResult === 'close') {\r\n              \/\/ 关闭所有弹窗\r\n              return;\r\n            }\r\n            \/\/ 其他情况继续显示主菜单\r\n            continue;\r\n          }\r\n          if (picked === 1) {\r\n            zdjl.setClipboard(result.merchantName || '');\r\n            zdjl.toast('已复制：商家名称');\r\n            console.log('已手动复制：商家名称\\n' + (result.merchantName || ''));\r\n            continue;\r\n          }\r\n          if (picked === 2) {\r\n            zdjl.setClipboard(result.merchantDetailAddress || '');\r\n            zdjl.toast('已复制：取货地址');\r\n            console.log('已手动复制：取货地址\\n' + (result.merchantDetailAddress || ''));\r\n            continue;\r\n          }\r\n          if (picked === 3) {\r\n            zdjl.setClipboard(result.customerAddress || '');\r\n            zdjl.toast('已复制：顾客地址');\r\n            console.log('已手动复制：顾客地址\\n' + (result.customerAddress || ''));\r\n            continue;\r\n          }\r\n\r\n          if (hasSwitch && picked === 4) {\r\n            \/\/ 切换订单：退出复制菜单，回到外层循环重新生成 result\r\n            selectedIdx = await pickOrderIndexInteractive(orders);\r\n            break;\r\n          }\r\n\r\n          \/\/ 关闭\/未选中\/未知返回 - 直接关闭所有弹窗\r\n          return;\r\n        }\r\n      } catch (e) {\r\n        \/\/ 部分版本可能不支持 selectAsync，fallback 为 confirm\r\n        try {\r\n          const ok = await zdjl.confirmAsync(`已提取：\\n\\n${clip}\\n\\n点击“确定”复制【全部三行】到剪贴板`, {\r\n            title: '点击复制'\r\n          });\r\n          if (ok) {\r\n            zdjl.setClipboard(clip);\r\n            zdjl.toast('已复制到剪贴板');\r\n          }\r\n        } catch (_) {\r\n          \/\/ ignore\r\n        }\r\n        return;\r\n      }\r\n    } else {\r\n      return;\r\n    }\r\n  }\r\n}\r\n\r\nmain();\r\n\r\n"}
{"type":"运行JS代码","disabled":true,"delay":"0","delayUnit":1,"desc":"抓取控件用","jsCode":"\/**\n * 自动精灵：抓取当前页面控件树并保存到文件（JSON）\n *\n * 输出内容：\n * - rawTree: 以 android:id\/content 为根的原始树结构（withChildren）\n * - flat:    将 rawTree 扁平化后的常用字段列表（便于 grep\/检索）\n *\n * 保存位置（优先）：\n * - \/sdcard\/zdjl_nodes_<时间>.json\n * - \/storage\/emulated\/0\/zdjl_nodes_<时间>.json\n *\n * 用法：\n * - 在目标页面（例如包含 “1点点(后埔店)” 的页面）运行本脚本\n * - 运行结束后会 toast 提示保存路径，并复制路径到剪贴板\n *\/\n\nfunction pad2(n) {\n  return String(n).padStart(2, '0');\n}\n\nfunction nowStamp() {\n  const d = new Date();\n  return (\n    d.getFullYear() +\n    pad2(d.getMonth() + 1) +\n    pad2(d.getDate()) +\n    '_' +\n    pad2(d.getHours()) +\n    pad2(d.getMinutes()) +\n    pad2(d.getSeconds())\n  );\n}\n\nfunction normalizeText(t) {\n  if (!t) return '';\n  return String(t).replace(\/\\u00a0\/g, ' ').trim();\n}\n\nfunction getBounds(node) {\n  \/\/ 自动精灵返回的 node 可能直接带 bounds: {l,t,r,b}\n  if (node && node.bounds && typeof node.bounds === 'object') {\n    const { l, t, r, b } = node.bounds;\n    if ([l, t, r, b].every(v => Number.isFinite(v))) return { l, t, r, b };\n  }\n  \/\/ 兼容其它字段\n  const l = node?.boundLeft ?? node?.boundsLeft ?? node?.left;\n  const t = node?.boundTop ?? node?.boundsTop ?? node?.top;\n  const r = node?.boundRight ?? node?.boundsRight ?? node?.right;\n  const b = node?.boundBottom ?? node?.boundsBottom ?? node?.bottom;\n  if ([l, t, r, b].every(v => Number.isFinite(v))) return { l, t, r, b };\n  return null;\n}\n\nfunction traverse(node, out) {\n  if (!node) return;\n  out.push(node);\n  const children = node.children || node.childNodes || node.child || node.nodes || [];\n  if (Array.isArray(children)) {\n    for (const c of children) traverse(c, out);\n  }\n}\n\nfunction flattenTree(root) {\n  const all = [];\n  traverse(root, all);\n  const flat = [];\n  for (const n of all) {\n    if (!n || typeof n !== 'object') continue;\n    flat.push({\n      idResName: n.idResName ?? '',\n      text: normalizeText(n.text),\n      className: n.className ?? '',\n      packageName: n.packageName ?? '',\n      bounds: getBounds(n)\n    });\n  }\n  return flat;\n}\n\nfunction writeTextFile(filePath, content) {\n  \/\/ 优先 node fs（README 推荐），失败则 fallback 到 zdjl.writeFile\n  try {\n    const fs = require('fs');\n    fs.writeFileSync(filePath, content);\n    return true;\n  } catch (_) {\n    try {\n      zdjl.writeFile(filePath, content);\n      return true;\n    } catch (e) {\n      console.error('写文件失败：', e);\n      return false;\n    }\n  }\n}\n\nasync function main() {\n  \/\/ 默认不自动打开控制台，避免打扰；需要调试时手动打开即可\n  await zdjl.sleepAsync?.(200);\n\n  \/\/ 以 content 为根抓取（最通用）\n  let rawTree = zdjl.findNode({ type: 'node', idResName: 'android:id\/content' }, { withChildren: true });\n\n  \/\/ fallback：部分页面可能没有 content，可再尝试常见根节点\n  if (!rawTree) {\n    rawTree = zdjl.findNode(\n      { type: 'node', idResName: 'me.ele.crowdsource:id\/action_bar_root' },\n      { withChildren: true }\n    );\n  }\n\n  if (!rawTree) {\n    zdjl.toast('没抓到根节点（android:id\/content），请确认在目标页面');\n    console.error('rawTree is null');\n    return;\n  }\n\n  const flat = flattenTree(rawTree);\n  const uniqIdResName = Array.from(new Set(flat.map(x => x.idResName).filter(Boolean))).sort();\n\n  const payload = {\n    generatedAt: new Date().toISOString(),\n    note: 'rawTree 为 findNode(withChildren) 的结构；flat 为扁平化列表（常用字段），便于检索。',\n    rootHint: rawTree.idResName ?? 'unknown',\n    flatCount: flat.length,\n    uniqIdResNameCount: uniqIdResName.length,\n    uniqIdResName,\n    flat,\n    rawTree\n  };\n\n  const filename = `zdjl_nodes_${nowStamp()}.json`;\n  const candidates = [`\/sdcard\/${filename}`, `\/storage\/emulated\/0\/${filename}`];\n  let savedPath = null;\n\n  const jsonText = JSON.stringify(payload, null, 2);\n  for (const p of candidates) {\n    if (writeTextFile(p, jsonText)) {\n      savedPath = p;\n      break;\n    }\n  }\n\n  if (!savedPath) {\n    zdjl.toast('保存失败：无可写路径（检查存储权限）');\n    console.error('save failed');\n    return;\n  }\n\n  console.log(`已保存：${savedPath}（flatCount=${flat.length}）`);\n  zdjl.toast(`已保存控件树：${savedPath}`, 5000);\n  try {\n    zdjl.setClipboard(savedPath);\n  } catch (_) {\n    \/\/ ignore\n  }\n}\n\nmain();\n"}
