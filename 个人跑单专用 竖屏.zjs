evHmDi4sLqJbQPWXQomy+UES1WsXNmzcjV8Co9fdx7IcNSSiiUj6hISziD+KCGYqRnhoNspXlLeNT5Qr+qmFZUB5kDfRv66ElCkKTGxS\/hsUgJxEGocnpbteV3DJhe0pZdjBrKiLKQtEsHEJOpGXZz3t51Tbj+69LOIzsyOP1WjkWhKi1fNb\/\/RqTSyrG5JKKMbmkYkwuqfgPj4GtA1u5xiIAAAAASUVORK5CYII=","imageWidth":55,"imageHeight":70,"imageLeft":22,"imageTop":1236,"screenWidth":1200,"screenHeight":1920,"screenDpi":1.625},"limitArea":"0% 61.2% 14.2% 70.9%","searchMode":"color_2.21","minSimilarPercent":96,"codeVersion":"V1_7","imageScaleType":"dpi"},"desc":""},"scriptCallbacks":{"afterConditionSuc":{"type":"控制执行","delay":"0.5","delayUnit":1,"controlRunType":"waitDelay","ContinueParentExecute":false},"afterConditionFail":{"type":"控制执行","delay":"0","delayUnit":1,"controlRunType":"jumpTo","jumpToPosition":"4","ContinueParentExecute":false},"afterExecSuc":{"type":"点击","duration":"400","delayUnit":1,"desc":"点击第一个位置","posData":{"type":"location","x":"25.7%","y":"19.4%"}}},"posData":{"type":"location","x":"7.6%","y":"65.9%"}}
{"type":"点击文字","delay":"0.20","delayUnit":1,"desc":"点击切换到电单车的时间估算方案（美团地图根本就没有适配电动车的）","scriptCallbacks":{"afterExecSuc":{"type":"控制执行","delay":"1","delayUnit":1,"controlRunType":"waitDelay","jumpToPosition":"","ContinueParentExecute":false},"afterExecFail":{"type":"控制执行","delay":"0","delayUnit":1,"controlRunType":"jumpTo","jumpToPosition":"5","ContinueParentExecute":false}},"posData":{"type":"text","text":"电单车","limitArea":"3.3% 72.2% 25.8% 89.9%","ocrMode":"local"}}
{"type":"运行JS代码","delay":"0.7","delayUnit":1,"desc":"利用代码匹配最快方案","jsCode":"\/\/ 定义函数：动态分区识别方案，综合时间和距离选择最优方案（推荐方案则跳过点击）\nasync function selectOptimalRouteByDynamicArea() {\n  function distanceToMeters(distance, unit) {\n    if (!Number.isFinite(distance)) return Number.POSITIVE_INFINITY;\n    if (unit === '公里') return distance * 1000;\n    if (unit === '米') return distance;\n    return Number.POSITIVE_INFINITY;\n  }\n\n  \/**\n   * 解析单个方案区块 OCR 文本\n   * 需求：\n   * - 自动精灵无法匹配红绿灯图标，因此用“公里后面的数字”判断红绿灯数量\n   * - “公里后有数字” => 有红绿灯；“公里后无数字” => 无红绿灯（记为0）\n   * - 最好分开匹配：先匹配带红绿灯数字的，再匹配不带的\n   *\/\n  function parseSchemeFromOcrText(resultText) {\n    if (!resultText) return null;\n\n    \/\/ 方案名 + 用时 + 距离（公里\/米）+ 单位后面的数字（红绿灯数量）\n    \/\/ 说明：\n    \/\/ - OCR 结果可能分行，因此用 [\\s\\S]*? 代替 .*?（可跨换行）\n    \/\/ - 自动精灵无法匹配红绿灯图标，图标可能被 OCR 成 0\/O\n    \/\/ - 因此：在单位后允许若干个 0\/O 噪声并跳过，再抓真正的数量数字\n    const schemeWithLightsRegex =\n      \/(推荐方案|方案二|方案三)[\\s\\S]*?(\\d+)分钟[\\s\\S]*?(\\d+(?:\\.\\d+)?)(公里|米)\\D*(?:[0Oo]\\D*)*(\\d{1,3})\/;\n\n    \/\/ 方案名 + 用时 + 距离（公里\/米），不包含红绿灯数字（默认无红绿灯）\n    const schemeNoLightsRegex =\n      \/(推荐方案|方案二|方案三)[\\s\\S]*?(\\d+)分钟[\\s\\S]*?(\\d+(?:\\.\\d+)?)(公里|米)\/;\n\n    let m = resultText.match(schemeWithLightsRegex);\n    if (m) {\n      const [, schemeName, timeStr, distanceStr, distanceUnit, lightsStr] = m;\n      const time = parseInt(timeStr, 10);\n      const distance = parseFloat(distanceStr);\n      const trafficLights = parseInt(lightsStr, 10);\n      return {\n        name: schemeName,\n        time,\n        distance,\n        unit: distanceUnit,\n        trafficLights: Number.isFinite(trafficLights) ? trafficLights : 0,\n        hasTrafficLights: Number.isFinite(trafficLights) && trafficLights > 0\n      };\n    }\n\n    m = resultText.match(schemeNoLightsRegex);\n    if (m) {\n      const [, schemeName, timeStr, distanceStr, distanceUnit] = m;\n      const time = parseInt(timeStr, 10);\n      const distance = parseFloat(distanceStr);\n      return {\n        name: schemeName,\n        time,\n        distance,\n        unit: distanceUnit,\n        trafficLights: 0,\n        hasTrafficLights: false\n      };\n    }\n\n    return null;\n  }\n\n  while (true) {\n    try {\n      \/\/ 固定检测高度范围：top 85% - bottom 91.4%\n      const FIXED_RECOG_AREA = {\n        top: '85%',\n        bottom: '91.4%'\n      };\n      let schemeCount = 0; \/\/ 识别到的方案总数\n      let schemeList = []; \/\/ 存储所有方案详情\n\n      \/************************ 第一步：识别方案数量（仅匹配用时 X分钟） ************************\/\n      const globalTimeResult = await zdjl.recognitionScreenAsync({\n        recognitionArea: { ...FIXED_RECOG_AREA, left: '0%', right: '100%' },\n        recognitionMode: 'ocr_local'\n      });\n      const timeMatches = globalTimeResult ? globalTimeResult.match(\/\\d+分钟\/g) : [];\n      schemeCount = timeMatches.length;\n\n      if (schemeCount === 1) {\n        console.log('只有一个方案，直接跳过');\n        zdjl.toast(`就一个方案，摆了摆了~`);\n        return;\n      }\n      if (schemeCount === 0) {\n        console.error('未识别到任何方案，重试...');\n        zdjl.toast('寄！一个方案都没识别到，重试中');\n        continue;\n      }\n      console.log(`识别到 ${schemeCount} 个方案，开始动态分区识别详情`);\n\n      \/************************ 第二步：动态生成分区规则，逐个识别方案详情 ************************\/\n      let dynamicAreas = [];\n      if (schemeCount === 2) {\n        dynamicAreas = [\n          { index: 1, left: '0%', right: '50%', name: '推荐方案' },\n          { index: 2, left: '50%', right: '100%', name: '方案二' }\n        ];\n      } else if (schemeCount === 3) {\n        dynamicAreas = [\n          { index: 1, left: '0%', right: '33%', name: '推荐方案' },\n          { index: 2, left: '33%', right: '66%', name: '方案二' },\n          { index: 3, left: '66%', right: '100%', name: '方案三' }\n        ];\n      } else {\n        dynamicAreas = [\n          { index: 1, left: '0%', right: '33%', name: '推荐方案' },\n          { index: 2, left: '33%', right: '66%', name: '方案二' },\n          { index: 3, left: '66%', right: '100%', name: '方案三' }\n        ];\n      }\n\n      \/\/ 遍历动态分区，识别每个区域内的方案详情\n      for (const area of dynamicAreas) {\n        const recognitionArea = { ...FIXED_RECOG_AREA, left: area.left, right: area.right };\n        const result = await zdjl.recognitionScreenAsync({\n          recognitionArea,\n          recognitionMode: 'ocr_local'\n        });\n        if (!result) continue;\n\n        const parsed = parseSchemeFromOcrText(result);\n        if (!parsed) continue;\n        schemeList.push({\n          index: area.index,\n          name: parsed.name, \/\/ 纯方案名（如“方案三”）\n          time: parsed.time,\n          distance: parsed.distance,\n          unit: parsed.unit,\n          trafficLights: parsed.trafficLights,\n          hasTrafficLights: parsed.hasTrafficLights,\n          area: recognitionArea, \/\/ 方案所在的分区\n          fullText: result \/\/ 存储区域完整识别文本，用于调试\n        });\n      }\n\n      \/\/ 过滤有效方案\n      const validSchemes = schemeList.filter(\n        s => Number.isFinite(s.time) && Number.isFinite(s.distance) && s.time > 0 && s.distance > 0\n      );\n      if (validSchemes.length < 2) {\n        console.error(`有效方案数不足（${validSchemes.length}个），重试...`);\n        zdjl.toast(`寄！有效方案不足，重试中`);\n        continue;\n      }\n      console.log(\n        '有效方案列表：',\n        validSchemes.map(\n          s =>\n            `${s.name} - ${s.time}分钟 - ${s.distance}${s.unit} - 红绿灯:${s.trafficLights ?? 0}`\n        )\n      );\n\n      \/************************ 第三步：综合用时 + 红绿灯数量选择最优方案 ************************\/\n      \/\/ 规则：\n      \/\/ - 若存在“唯一最短用时”的方案：直接选它\n      \/\/ - 若两\/三条方案用时相同：优先红绿灯更少（公里后有数字=有红绿灯；无数字=0）\n      \/\/ - 再相同：按距离更短（统一换算成米）\n      const minTime = Math.min(...validSchemes.map(s => s.time));\n      const minTimeSchemes = validSchemes.filter(s => s.time === minTime);\n\n      let optimalScheme;\n      if (minTimeSchemes.length === 1) {\n        optimalScheme = minTimeSchemes[0];\n      } else {\n        const sortedTies = [...minTimeSchemes].sort((a, b) => {\n          const aLights = Number.isFinite(a.trafficLights) ? a.trafficLights : 0;\n          const bLights = Number.isFinite(b.trafficLights) ? b.trafficLights : 0;\n          if (aLights !== bLights) return aLights - bLights;\n          return distanceToMeters(a.distance, a.unit) - distanceToMeters(b.distance, b.unit);\n        });\n        optimalScheme = sortedTies[0];\n      }\n\n      console.log(\n        `最优方案：${optimalScheme.name} - ${optimalScheme.time}分钟 - ${optimalScheme.distance}${optimalScheme.unit} - 红绿灯:${optimalScheme.trafficLights ?? 0}`\n      );\n\n      \/************************ 第四步：最优为推荐方案则跳过点击 ************************\/\n      if (optimalScheme.name === '推荐方案') {\n        console.log('最优方案是推荐方案，跳过点击');\n        zdjl.toast(`最优方案是推荐方案，摆了~`);\n        return;\n      }\n\n      \/************************ 第五步：直接按方案分区中心坐标点击 ************************\/\n      console.log('按方案分区中心坐标点击');\n      \/\/ 计算分区中心坐标（百分比）\n      const area = optimalScheme.area;\n      const centerX = (parseFloat(area.left) + parseFloat(area.right)) \/ 2;\n      const centerY = (parseFloat(area.top) + parseFloat(area.bottom)) \/ 2;\n      \/\/ 执行点击（百分比坐标）\n      await zdjl.clickAsync(`${centerX}%`, `${centerY}%`);\n      console.log(`已点击${optimalScheme.name}分区中心：${centerX}%, ${centerY}%`);\n      zdjl.toast(\n        `芜湖~最优方案是${optimalScheme.name}，${optimalScheme.time}分钟，红绿灯${optimalScheme.trafficLights ?? 0}个冲！`\n      );\n      return;\n\n    } catch (error) {\n      console.error('执行错误：', error);\n      const errMsg = error.message ? error.message.slice(0, 10) : '未知错误';\n      zdjl.toast(`寄！出bug了：${errMsg}`);\n      \/\/ 错误后短暂延迟再重试，避免高频循环\n      await new Promise(resolve => setTimeout(resolve, 500));\n    }\n  }\n}\n\n\/\/ 执行最终优化后的逻辑\nselectOptimalRouteByDynamicArea();"}
{"type":"点击文字","delay":"0","delayUnit":1,"scriptCallbacks":{"afterExecSuc":{"type":"控制执行","delay":"1500","delayUnit":0,"controlRunType":"waitDelay","jumpToPosition":"","ContinueParentExecute":false},"afterExecFail":{"type":"控制执行","delay":"0","delayUnit":1,"controlRunType":"jumpTo","jumpToPosition":"7","ContinueParentExecute":false}},"posData":{"type":"text","text":"开始导航","limitArea":"29.3% 91.2% 77.6% 100%","ocrMode":"local"}}
{"type":"运行JS代码","delay":"0","delayUnit":1,"desc":"导航中途持续检测快X分钟","scriptCallbacks":{"afterExecFail":{"type":"控制执行","delay":"0","delayUnit":1,"controlRunType":"waitDelay","ContinueParentExecute":false}},"jsCode":"\/\/ 定义识别区域（百分比坐标，适配多屏幕）\nconst area = {\n  left: '0%',\n  top: '28%',\n  right: '100%',\n  bottom: '90%'\n};\n\n\/\/ 本地快速OCR识别\nconst result = zdjl.recognitionScreen({\n  recognitionArea: area,\n  recognitionMode: 'ocr_local_comp' \/\/ 本地快速识别模式\n});\n\n\/\/ 全局正则匹配所有「快X分钟」格式（新增g标志）\nconst matches = result.match(\/(快(\\d+)分钟)\/g); \/\/ 匹配所有结果\nlet maxMinutes = 0;\nlet targetText = '';\n\nif (matches && matches.length > 0) {\n  \/\/ 遍历所有匹配项，提取最大分钟数\n  matches.forEach(text => {\n    const num = parseInt(text.match(\/\\d+\/)[0]); \/\/ 提取数字部分\n    if (num > maxMinutes) {\n      maxMinutes = num;\n      targetText = text; \/\/ 记录最大分钟数对应的完整文本\n    }\n  });\n\n  if (maxMinutes > 0) {\n    \/\/ 存储最大分钟数到脚本变量（全局作用域可加'global'参数）\n    zdjl.setVar('maxMinutes', maxMinutes); \n    console.log(`检测到最大快${maxMinutes}分钟`);\n\n    \/\/ 获取最大分钟数文本的坐标\n    const location = zdjl.findLocation({\n      type: 'text',\n      text: targetText, \/\/ 用最大分钟数对应的文本精准定位\n      ocrMode: 'local' \/\/ 本地OCR查找坐标\n    });\n\n    if (location) {\n      \/\/ 点击坐标（使用物理像素或百分比坐标）\n      zdjl.click(location.x, location.y);\n      \n      \/\/ 随机展示带最大分钟数的提示文案（显示10秒）\nconst tips = [\n  \"老司机发车！提速${minutes}分钟，这波操作稳如泰山～\",\n  \"路线优化成功！快${minutes}分钟送达，爆单小目标达成～\",\n  \"欸嘿！${minutes}分钟近道已解锁，本司机带你飞～\",\n  \"快${minutes}分钟冲鸭！这效率，同行看了都得喊666～\",\n  \"别眨眼！${minutes}分钟极速模式开启，风驰电掣搞钱去～\",\n  \"秋名山车神附体！省下${minutes}分钟，油门一踩谁都不爱～\",\n  \"方向盘在手，天下我有！抄近路省下${minutes}分钟，主打一个速度与激情～\",\n  \"老司机的隐藏技能发动！${minutes}分钟超车路线已激活，准备起飞～\",\n  \"道路千万条，效率第一条！快${minutes}分钟送达，这波血赚不亏～\",\n  \"导航在手，漂移我有！${minutes}分钟极限路线，带你体验现实版头文字D～\",\n  \"嘀嘀！老司机专属快车道已开通，快${minutes}分钟，主打一个遥遥领先～\",\n  \"谁说送单不能秀操作？${minutes}分钟极限拉扯，轻松拿捏每一单～\",\n  \"引擎轰鸣，肾上腺素飙升！省下${minutes}分钟，这波操作直接封神～\",\n  \"别问，问就是老司机的直觉！${minutes}分钟超快路线，直接杀疯了～\",\n  \"前方高能！${minutes}分钟飙车模式启动，速度直接拉满～\",\n  \"看我蛇皮走位！省下${minutes}分钟，订单再多也追不上我的脚步～\"\n];\n\nconst randomIndex = Math.floor(Math.random() * tips.length);\n      const tip = tips[randomIndex].replace('${minutes}', maxMinutes);\n      zdjl.toast(tip, 10000);\n      console.log(`已点击最大快${maxMinutes}分钟按钮，提示：${tip}`);\n\n      \/\/ 暂停逻辑\n      zdjl.sleep(10000);\n    } else {\n      console.error(`未找到「${targetText}」坐标`);\n    }\n  } else {\n    console.log('未匹配到有效分钟数');\n  }\n} else {\n  console.log('未匹配到快X分钟文本');\n}"}
