PWXQomy+UES1WsXNmzcjV8Co9fdx7IcNSSiiUj6hISziD+KCGYqRnhoNspXlLeNT5Qr+qmFZUB5kDfRv66ElCkKTGxS\/hsUgJxEGocnpbteV3DJhe0pZdjBrKiLKQtEsHEJOpGXZz3t51Tbj+69LOIzsyOP1WjkWhKi1fNb\/\/RqTSyrG5JKKMbmkYkwuqfgPj4GtA1u5xiIAAAAASUVORK5CYII=","imageWidth":55,"imageHeight":70,"imageLeft":22,"imageTop":1236,"screenWidth":1200,"screenHeight":1920,"screenDpi":1.625},"limitArea":"0% 61.2% 14.2% 70.9%","searchMode":"color_2.21","minSimilarPercent":96,"codeVersion":"V1_7","imageScaleType":"dpi"},"desc":""},"desc":"然后粘贴地址，再点击起点入框，点击「我的位置」，1 .5 秒后，点击第一个结果，跳转第四步","scriptCallbacks":{"afterConditionFail":{"type":"控制执行","delay":"0","delayUnit":1,"controlRunType":"jumpTo","jumpToPosition":"15","ContinueParentExecute":false},"afterExecSuc":{"type":"点击","duration":"200","delay":"0","delayUnit":1,"desc":"点击第一个结果","scriptCallbacks":{"afterExecSuc":{"type":"点击文字","delay":"0","delayUnit":1,"desc":"点击我的位置","scriptCallbacks":{"afterExecSuc":{"type":"点击","delay":"1500","delayUnit":0,"desc":"1 秒 后，点击第一个结果","scriptCallbacks":{"afterExecSuc":{"type":"控制执行","delay":"0","delayUnit":1,"controlRunType":"jumpTo","jumpToPosition":"4","ContinueParentExecute":false}},"posData":{"type":"location","x":"23.2%","y":"19.1%"}}},"posData":{"type":"text","text":"我的位置","limitArea":"7.5% 10.8% 29.5% 17.2%","ocrMode":"local"}}},"posData":{"type":"location","x":"23.8%","y":"5.2%"}}},"jsCode":"var INPUT_BOX_X = '18%';\r\nvar INPUT_BOX_Y = '7.8%';\r\nvar OCR_AREA = '25% 87% 85% 100%';\r\nvar CLICK_DURATION = 50;\r\nvar KEYBOARD_WAIT_TIME = 500;\r\n\r\nvar clipboardText = zdjl.getClipboard();\r\nvar hasUnmatch = clipboardText && clipboardText.indexOf('[UNMATCH]') !== -1;\r\nvar isTrue = false;\r\n\r\nif (hasUnmatch) {\r\n    var filteredText = clipboardText.substring(9);\r\n    zdjl.setClipboard(filteredText);\r\n    isTrue = true;\r\n    zdjl.setVar('unmatch_status', 'true');\r\n} else {\r\n    isTrue = false;\r\n    zdjl.setVar('unmatch_status', 'false');\r\n    \r\n    \/\/ 通过写入随机字符再改回来，触发剪贴板快捷粘贴显示\r\n    var randomChar = Math.random().toString(36).substring(2, 3);\r\n    zdjl.setClipboard(randomChar);\r\n    zdjl.sleep(50);\r\n    zdjl.setClipboard(clipboardText || '');\r\n}\r\n\r\ntry {\r\n    zdjl.touchDown(INPUT_BOX_X, INPUT_BOX_Y);\r\n    zdjl.sleep(CLICK_DURATION);\r\n    zdjl.touchUp();\r\n    zdjl.sleep(KEYBOARD_WAIT_TIME);\r\n} catch (e) {\r\n    zdjl.click(INPUT_BOX_X, INPUT_BOX_Y, CLICK_DURATION);\r\n    zdjl.sleep(KEYBOARD_WAIT_TIME);\r\n}\r\n\r\nif (isTrue) {\r\n    var checkInterval = 1000;\r\n    \r\n    while (true) {\r\n        var recognitionResult = zdjl.recognitionScreen({\r\n            recognitionArea: OCR_AREA,\r\n            recognitionMode: 'ocr_local'\r\n        });\r\n        \r\n        var ocrText = '';\r\n        if (recognitionResult) {\r\n            if (typeof recognitionResult === 'string') {\r\n                ocrText = recognitionResult;\r\n            } else if (recognitionResult.text) {\r\n                ocrText = String(recognitionResult.text);\r\n            } else if (recognitionResult.result) {\r\n                ocrText = String(recognitionResult.result);\r\n            }\r\n        }\r\n        \r\n        if (ocrText && ocrText.indexOf('开始导航') !== -1) {\r\n            zdjl.toast('检测到「开始导航」，脚本结束');\r\n            break;\r\n        }\r\n        \r\n        zdjl.sleep(checkInterval);\r\n    }\r\n}\r\n\r\n"}
