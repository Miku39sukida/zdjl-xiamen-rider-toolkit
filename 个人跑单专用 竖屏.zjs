{"type":"系统提示","delay":"0","delayUnit":1,"condition":{"type":"textFount","text":{"type":"text","text":"开始导航","limitArea":"32.6% 92% 83.9% 100%","ocrMode":"local"},"desc":""},"desc":"若中途退出导航，将弹窗询问，目前有六个选项","scriptCallbacks":{"afterConditionFail":{"type":"控制执行","delay":"0","delayUnit":1,"controlRunType":"jumpTo","jumpToPosition":"8","ContinueParentExecute":false}},"promptType":"alert","promptText":"手滑退导航别慌，选个操作接着冲！","promptTitle":"跑单导航寄了？续命中心","showPosition":"default","playAudio":"false","useVibrator":false,"actions":[{"name":"换个目标，重新开冲","script":{"type":"控制执行","delay":"300","delayUnit":0,"controlRunType":"jumpTo","jumpToPosition":"14","ContinueParentExecute":false}},{"name":"校准起点，原地复活","script":{"type":"控制执行","delay":"300","delayUnit":0,"controlRunType":"jumpTo","jumpToPosition":"16","ContinueParentExecute":false}},{"name":"路线刷新，精准开跑","script":{"type":"控制执行","delayUnit":1,"controlRunType":"jumpTo","jumpToPosition":"19","ContinueParentExecute":false}},{"name":"到站！下一站走起","script":{"type":"控制执行","delayUnit":1,"controlRunType":"jumpTo","jumpToPosition":"11","ContinueParentExecute":false}},{"name":"没点到剪贴板\/切下一个目的地？重来操作","script":{"type":"点击","duration":"100","delay":"0","delayUnit":1,"desc":"点击终点🏁输入框","scriptCallbacks":{"afterExecSuc":{"type":"控制执行","delay":"0","delayUnit":1,"controlRunType":"jumpTo","jumpToPosition":"2","ContinueParentExecute":false}},"posData":{"type":"location","x":"18%","y":"7.8%"}}},{"name":"手滑退导航？接着冲","script":{"type":"点击文字","delayUnit":1,"scriptCallbacks":{"afterExecSuc":{"type":"控制执行","delayUnit":1,"controlRunType":"jumpTo","jumpToPosition":"8","ContinueParentExecute":false}},"posData":{"type":"text","text":"开始导航","limitArea":"22.5% 90.3% 80% 100%","ocrMode":"local"}}}]}
